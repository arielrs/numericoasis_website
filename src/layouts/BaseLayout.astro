---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE, CLOUDFLARE_ANALYTICS_TOKEN } from '../consts';
import { buildGraph, type Crumb, type JsonLdNode } from '../lib/schema';
import { resolveOgImage } from '../lib/og';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LocaleSuggestion from '../components/LocaleSuggestion.astro';
import {
  detectLangFromPath,
  HTML_LANG_MAP,
  localeUrls,
  withLocale,
  useTranslations,
  type LocaleAlternates,
} from '../i18n';

interface Props {
  title: string;
  /** Long form. Feeds the structured data, where length is an asset. */
  description?: string;
  /** Capped at ~160 characters, for the SERP snippet. Falls back to the above. */
  metaDescription?: string;
  /** An imported asset (preferred, so real dimensions are used) or a path into public/. */
  image?: ImageMetadata | string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
    tags?: readonly string[];
  };
  noindex?: boolean;
  /** Overrides for pages whose per-locale URLs are not simple mirrors. */
  alternates?: LocaleAlternates;
  /** Page-owned structured data, merged into the single per-page @graph. */
  graph?: {
    breadcrumbs?: Crumb[];
    extraNodes?: JsonLdNode[];
    primaryEntityId?: string;
    pageType?: string;
  };
}

const { title, description, metaDescription, image, article, noindex, alternates, graph = {} } = Astro.props;
const lang = detectLangFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const urls = localeUrls(Astro.url.pathname, alternates);
const canonical = new URL(urls[lang], Astro.site!).toString();
const ogImage = await resolveOgImage(image);

const jsonLd = buildGraph({
  lang,
  canonical,
  name: title,
  description: description ?? SITE.description,
  image: ogImage,
  homeLabel: t.common.home,
  ...graph,
});

---

<!doctype html>
<html lang={HTML_LANG_MAP[lang]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Scroll reveals hide their content, so the rule that hides it is gated
         behind this class. It is set here, inline and before any paint, so
         there is no flash of already-visible content; and it is set by script,
         so a reader with JavaScript off never gets the hidden state at all. -->
    <script is:inline>
      document.documentElement.classList.add('js-motion');
    </script>
    <!-- The favicon used to point at a 442x468, 208KB PNG, which was 51 to 76
         percent of every cold page load and, being non-square, would have been
         squashed as an iOS home-screen icon. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-inter" preload />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} blog`}
      href={withLocale(lang, '/rss.xml')}
    />
    <SEO
      title={title}
      description={metaDescription ?? description}
      ogImage={ogImage}
      article={article}
      noindex={noindex}
      lang={lang}
      alternates={alternates}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {import.meta.env.PROD && CLOUDFLARE_ANALYTICS_TOKEN && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CLOUDFLARE_ANALYTICS_TOKEN}"}`}
      />
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-brand-900 focus:px-3 focus:py-2 focus:text-sm focus:text-white"
    >{t.common.skipToContent}</a>
    <Nav lang={lang} alternates={alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <LocaleSuggestion currentLang={lang} alternates={alternates} />

    <script>
      /**
       * One observer for every reveal on every page.
       *
       * Elements marked `.reveal` gain `.is-visible` when they come within
       * 10% of the viewport bottom, and are then unobserved: a reveal is a
       * one-way trip, so nothing re-hides on the way back up.
       *
       * Siblings inside a `[data-reveal-group]` stagger 70ms apart, capped at
       * six steps so a long list does not end with a half-second wait. The
       * delay is a custom property rather than a class, so the reduced-motion
       * block can zero every one of them with a single rule.
       *
       * Failure is safe by construction. If IntersectionObserver is missing,
       * or this script throws, everything is revealed immediately.
       */
      const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal-group]'));

      // Two ways in, matching the two CSS selectors: an element marked
      // `.reveal` itself, or any direct child of a marked group. The group form
      // means a section only has to tag its wrapper, and the children still
      // arrive one after another.
      const nodes = Array.from(
        new Set([
          ...document.querySelectorAll<HTMLElement>('.reveal'),
          ...groups.flatMap((g) => Array.from(g.children) as HTMLElement[]),
        ]),
      );

      const showAll = () => nodes.forEach((el) => el.classList.add('is-visible'));

      // Reduced motion resolves every reveal at once, deliberately.
      //
      // global.css already says this in words: decorative motion is damped
      // rather than stopped, but a reveal is not decorative, it is the content.
      // Leaving the observer in charge meant anything sitting in the bottom
      // tenth of the viewport stayed at opacity 0 until the reader scrolled,
      // and forever if they never did. Measured at 11 of 35 on-screen elements,
      // unchanged from 100ms through 1200ms. The script and the CSS intent now
      // agree.
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!('IntersectionObserver' in window) || calm.matches) {
        showAll();
      } else {
        for (const group of groups) {
          Array.from(group.children).forEach((el, i) => {
            (el as HTMLElement).style.setProperty('--reveal-delay', `${Math.min(i, 5) * 70}ms`);
          });
        }

        /**
         * The hero plays a fixed choreography on load, ending around 2s.
         * Anything already in the viewport at that moment would otherwise
         * reveal at 0ms and land in the middle of it, so the reader sees the
         * second section arrive before the headline has finished saying itself.
         * On a laptop that is exactly what happened to the proof strip.
         *
         * Reveals that fire while the hero is still running queue behind it,
         * and a batch arriving together is sorted into document order first, so
         * the page introduces itself top to bottom however tall the screen is.
         */
        const HERO_END = 2000;
        const started = performance.now();

        const observer = new IntersectionObserver(
          (entries) => {
            const arriving = entries.filter((entry) => entry.isIntersecting);
            if (!arriving.length) return;

            arriving.sort((a, b) =>
              a.target.compareDocumentPosition(b.target) & Node.DOCUMENT_POSITION_FOLLOWING
                ? -1
                : 1,
            );

            const elapsed = performance.now() - started;
            const queueBehindHero = elapsed < HERO_END ? HERO_END - elapsed : 0;

            arriving.forEach((entry, i) => {
              const el = entry.target as HTMLElement;
              if (queueBehindHero) {
                // Whatever stagger the element already carries from its group
                // is kept; the queue offset is added on top of it.
                const own = parseFloat(el.style.getPropertyValue('--reveal-delay')) || 0;
                el.style.setProperty(
                  '--reveal-delay',
                  `${own + queueBehindHero + Math.min(i, 8) * 80}ms`,
                );
              }
              el.classList.add('is-visible');
              observer.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0 },
        );

        nodes.forEach((el) => observer.observe(el));

        // A backstop for anything the observer never reports on, which can
        // happen if a container is display:none at load or the page is
        // restored from bfcache mid-scroll.
        window.setTimeout(showAll, 4000);
      }
    </script>
  </body>
</html>
