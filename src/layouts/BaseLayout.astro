---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE } from '../consts';
import { buildGraph, type Crumb, type JsonLdNode } from '../lib/schema';
import { resolveOgImage } from '../lib/og';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {
  detectLangFromPath,
  HTML_LANG_MAP,
  localeUrls,
  withLocale,
  useTranslations,
  type LocaleAlternates,
} from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** An imported asset (preferred, so real dimensions are used) or a path into public/. */
  image?: ImageMetadata | string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
    tags?: readonly string[];
  };
  noindex?: boolean;
  /** Overrides for pages whose per-locale URLs are not simple mirrors. */
  alternates?: LocaleAlternates;
  /** Page-owned structured data, merged into the single per-page @graph. */
  graph?: {
    breadcrumbs?: Crumb[];
    extraNodes?: JsonLdNode[];
    primaryEntityId?: string;
    pageType?: string;
  };
}

const { title, description, image, article, noindex, alternates, graph = {} } = Astro.props;
const lang = detectLangFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const urls = localeUrls(Astro.url.pathname, alternates);
const canonical = new URL(urls[lang], Astro.site!).toString();
const ogImage = await resolveOgImage(image);

const jsonLd = buildGraph({
  lang,
  canonical,
  name: title,
  description: description ?? SITE.description,
  image: ogImage,
  homeLabel: t.common.home,
  ...graph,
});

---

<!doctype html>
<html lang={HTML_LANG_MAP[lang]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/png_logo_main.png" />
    <link rel="apple-touch-icon" href="/png_logo_main.png" />
    <Font cssVariable="--font-inter" preload />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} blog`}
      href={withLocale(lang, '/rss.xml')}
    />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      article={article}
      noindex={noindex}
      lang={lang}
      alternates={alternates}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        try {
          var p = location.pathname;
          if (p !== '/' && p !== '/index.html') return;
          if (sessionStorage.getItem('locale-redirect-done') === '1') return;
          var stored = localStorage.getItem('preferred-locale');
          if (stored === 'pt-BR' || stored === 'es') {
            sessionStorage.setItem('locale-redirect-done', '1');
            location.replace('/' + stored + '/');
            return;
          }
          if (stored === 'en') {
            sessionStorage.setItem('locale-redirect-done', '1');
            return;
          }
          var langs = (navigator.languages && navigator.languages.length)
            ? navigator.languages
            : [navigator.language || ''];
          for (var i = 0; i < langs.length; i++) {
            var l = (langs[i] || '').toLowerCase();
            if (l === 'pt-br' || l === 'pt' || l.indexOf('pt-') === 0) {
              sessionStorage.setItem('locale-redirect-done', '1');
              location.replace('/pt-BR/');
              return;
            }
            if (l === 'es' || l.indexOf('es-') === 0) {
              sessionStorage.setItem('locale-redirect-done', '1');
              location.replace('/es/');
              return;
            }
            if (l === 'en' || l.indexOf('en-') === 0) break;
          }
          sessionStorage.setItem('locale-redirect-done', '1');
        } catch (e) { /* swallow */ }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-brand-900 focus:px-3 focus:py-2 focus:text-sm focus:text-white"
    >{t.common.skipToContent}</a>
    <Nav lang={lang} alternates={alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
