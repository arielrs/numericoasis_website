---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, PRODUCT_LABELS } from '../../consts';
import { contentSlug } from '../../i18n/paths';

const apps = (await getCollection('apps', ({ data }) => data.lang === 'es'))
  .filter((a) => a.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog', ({ data }) => data.lang === 'es' && !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout title={SITE.name} description="Numeric Oasis es una software house y consultoría. Quince años construyendo software a medida, publicando apps Atlassian Forge, asesorando sobre procesos de negocio y TI, y dando soporte a los equipos que lo hacen funcionar.">
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-white to-white">
    <div class="absolute inset-0 -z-10 opacity-60" aria-hidden="true">
      <div class="absolute -left-32 top-0 h-[480px] w-[480px] rounded-full bg-water-300/40 blur-3xl"></div>
      <div class="absolute right-0 top-32 h-[420px] w-[420px] rounded-full bg-sun-300/30 blur-3xl"></div>
    </div>

    <div class="container-wide pt-20 pb-24 sm:pt-28 sm:pb-32">
      <p class="eyebrow">Software house · Partner Atlassian Marketplace · Consultoría TI</p>
      <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-slate-900 sm:text-5xl md:text-6xl lg:text-7xl">
        Software, servicios y<br class="hidden md:block" />
        <span class="bg-gradient-to-r from-brand-700 via-water-500 to-sun-500 bg-clip-text text-transparent">15 años de know-how.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Construimos SaaS a medida y apps Atlassian Forge. Asesoramos sobre procesos de negocio y TI. Damos soporte a los equipos que los operan. Un único partner para construir, asesorar y operar.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/es/contact/" class="btn-primary">
          Iniciar un proyecto
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="/es/apps/" class="btn-secondary">Ver nuestras apps</a>
      </div>

      <dl class="mt-16 grid grid-cols-2 gap-8 border-t border-slate-200 pt-10 sm:grid-cols-4">
        {[
          { k: '15 años', v: 'Construyendo y asesorando' },
          { k: '4+ apps', v: 'En el Atlassian Marketplace' },
          { k: 'Atlassian', v: 'Partner Forge Marketplace' },
          { k: 'BR · EU · US', v: 'Horarios cubiertos' },
        ].map(({ k, v }) => (
          <div>
            <dt class="font-display text-3xl font-bold text-slate-900">{k}</dt>
            <dd class="mt-1 text-sm text-slate-500">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-paper-soft py-20 sm:py-28">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="eyebrow">Qué hacemos</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Cuatro formas de ayudar a los equipos a construir, operar y mejorar su software.
        </h2>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {[
          {
            title: 'Software a medida y SaaS',
            desc: 'SaaS desde cero, apps web y móviles, integraciones y plataformas a medida en TypeScript, Node y React.',
            icon: '🛠️',
          },
          {
            title: 'Apps de Atlassian y plataforma',
            desc: 'Apps Forge para el Marketplace, plugins a medida, migraciones, auditorías y salud de Jira y Confluence.',
            icon: '🧩',
          },
          {
            title: 'Consultoría de negocio y TI',
            desc: 'ITIL e ITSM, diseño de procesos, gobernanza y rollouts que convierten estrategia en operación real.',
            icon: '🧭',
          },
          {
            title: 'Soporte y servicios gestionados',
            desc: 'Soporte a largo plazo, SLAs y operación para el software que construimos y las plataformas que ejecutas.',
            icon: '🎧',
          },
        ].map((s) => (
          <article class="group rounded-2xl border border-slate-200 bg-white p-7 shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5 hover:border-water-300 hover:shadow-lg">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-brand-50 to-water-300/20 text-xl">
              <span aria-hidden="true">{s.icon}</span>
            </div>
            <h3 class="mt-5 font-display text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
          </article>
        ))}
      </div>

      <div class="mt-10">
        <a href="/es/services/" class="text-sm font-semibold text-water-700 hover:text-water-600">
          Ver todos los servicios →
        </a>
      </div>
    </div>
  </section>

  <!-- WORLDWIDE CUSTOM SOFTWARE -->
  <section class="py-20 sm:py-28">
    <div class="container-wide grid gap-12 lg:grid-cols-[2fr_3fr] lg:items-center">
      <div>
        <p class="eyebrow">Software house · 15 años</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
          Construimos software a medida para clientes en tres continentes.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-600">
          SaaS, herramientas internas, personalizaciones e integraciones, apps móviles. Si es software, está dentro de nuestro alcance. Trabajamos con empresas en América Latina, Europa y Estados Unidos, y todos los horarios intermedios.
        </p>
        <div class="mt-8 flex flex-wrap gap-2">
          {['SaaS', 'Software interno', 'Mobile', 'Integraciones', 'Personalizaciones'].map((tag) => (
            <span class="rounded-full border border-sand-200 bg-white px-3.5 py-1.5 text-sm font-medium text-brand-800">{tag}</span>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/es/services/#custom-software" class="btn-primary">
            Ver nuestros servicios
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/es/contact/" class="btn-secondary">Habla con el equipo</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          { h: 'SaaS desde cero', p: 'Plataformas modernas, alojadas, totalmente tuyas. Integraciones con el stack que ya usas.' },
          { h: 'Herramientas internas', p: 'Paneles, automatizaciones y flujos a medida que ahorran horas a tu día a día.' },
          { h: 'Apps móviles', p: 'Aplicaciones iOS y Android cuando el problema del cliente está lejos del escritorio.' },
          { h: 'Integraciones y personalizaciones', p: 'Conectamos sistemas. Extendemos plataformas. Personalizamos sin romper actualizaciones.' },
        ].map((c) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-[var(--shadow-soft)]">
            <h3 class="font-display text-lg font-semibold text-brand-900">{c.h}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ATLASSIAN COST REDUCTION TEASER -->
  <section class="bg-gradient-to-br from-brand-50 via-water-50 to-sun-50 py-20 sm:py-28">
    <div class="container-wide grid gap-10 lg:grid-cols-[3fr_2fr] lg:items-center">
      <div>
        <p class="eyebrow">Marketplace → Forge</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl md:text-5xl">
          Reduce tu gasto en apps Atlassian sin perder el workflow.
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700">
          Las apps del Marketplace cobran por usuario, para siempre. Reconstruimos el uso que realmente haces como apps Forge a medida, que viven dentro de la seguridad cloud de Atlassian y son tuyas. Menos licencias, mejor encaje, la misma confianza.
        </p>
        <div class="mt-8">
          <a href="/es/atlassian-app-cost-reduction/" class="btn-primary">
            Ve cómo bajamos tu coste en Atlassian
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
      <ul class="grid gap-3 text-sm text-slate-700">
        {[
          'Por usuario → coste fijo',
          'Sandbox de Forge, dentro de tu tenant',
          'Sin tránsito de datos por terceros',
          'Tú eres dueño del código y del roadmap',
        ].map((b) => (
          <li class="flex items-start gap-3 rounded-xl border border-white/60 bg-white/70 p-4 backdrop-blur">
            <svg class="mt-0.5 shrink-0 text-water-700" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-medium">{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="container-wide">
      <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow">Del Marketplace</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
            Apps usadas por equipos Atlassian.
          </h2>
        </div>
        <a href="/es/apps/" class="text-sm font-semibold text-water-700 hover:text-water-600">
          Ver todas las apps →
        </a>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {apps.map((app) => (
          <a
            href={`/es/apps/${contentSlug(app.id)}/`}
            class="group flex flex-col justify-between rounded-2xl border border-sand-200 bg-white p-7 transition hover:-translate-y-0.5 hover:border-water-400 hover:shadow-[var(--shadow-soft)]"
          >
            <div>
              <div class="flex items-center gap-4">
                {app.data.icon ? (
                  <Image
                    src={app.data.icon}
                    alt={`Logo ${app.data.name}`}
                    width={56}
                    height={56}
                    class="h-14 w-14 shrink-0 rounded-xl object-cover ring-1 ring-sand-200"
                  />
                ) : (
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-900 to-brand-700 font-display text-base font-bold text-white">
                    {app.data.name.charAt(0)}
                  </div>
                )}
                <div>
                  <h3 class="font-display text-xl font-semibold text-brand-900 group-hover:text-brand-700">
                    {app.data.name}
                  </h3>
                  <p class="mt-1 text-sm font-medium text-slate-700">{app.data.tagline}</p>
                </div>
              </div>
              <p class="mt-5 line-clamp-4 text-sm leading-relaxed text-slate-600">
                {app.data.description}
              </p>
              {app.data.audiences.length > 0 && (
                <p class="mt-4 text-xs leading-relaxed text-slate-500">
                  <span class="font-semibold text-brand-800">Hecho para:</span> {app.data.audiences.join(' · ')}
                </p>
              )}
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold">
              {app.data.products.map((p) => (
                <span class="rounded-full bg-water-50 px-2.5 py-1 text-water-700">{PRODUCT_LABELS[p] ?? p}</span>
              ))}
              {app.data.pricing && /^(free|gratis|gratuito)$/i.test(app.data.pricing) && (
                <span class="rounded-full bg-sun-50 px-2.5 py-1 text-sun-700">Gratis</span>
              )}
              <span class="ml-auto text-slate-400 transition group-hover:text-water-600">Saber más →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="border-t border-slate-200 bg-paper-soft py-20 sm:py-28">
      <div class="container-wide">
        <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
          <div>
            <p class="eyebrow">Del blog</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
              Notas del taller.
            </h2>
          </div>
          <a href="/es/blog/" class="text-sm font-semibold text-water-700 hover:text-water-600">
            Todos los posts →
          </a>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/es/blog/${contentSlug(post.id)}/`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-white transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)]"
            >
              {post.data.heroImage && (
                <div class="aspect-[16/10] overflow-hidden bg-sand-100">
                  <Image
                    src={post.data.heroImage}
                    alt=""
                    width={640}
                    height={400}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                  {post.data.pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <h3 class="mt-3 font-display text-lg font-semibold text-brand-900 group-hover:text-brand-700">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600">
                  {post.data.description}
                </p>
                <span class="mt-auto pt-4 text-xs font-semibold text-water-700">Leer post →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-20 sm:py-28">
    <div class="container-wide">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-900 via-brand-800 to-deep-700 p-10 sm:p-16">
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-sun-500/30 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -left-10 bottom-0 h-48 w-48 rounded-full bg-water-400/30 blur-3xl" aria-hidden="true"></div>
        <div class="relative max-w-2xl">
          <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
            ¿Tienes algo que construir, arreglar o repensar?
          </h2>
          <p class="mt-4 text-lg text-brand-100">
            Cuéntanos. Respondemos en un día hábil con una visión honesta y, si encajamos, con un camino a seguir.
          </p>
          <a href="/es/contact/" class="mt-8 inline-flex btn-primary !bg-white !text-brand-900 hover:!bg-brand-50">
            Empieza la conversación
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
