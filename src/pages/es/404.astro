---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="Esa página no existe en Numeric Oasis." noindex>
  <section class="flex min-h-[60vh] items-center justify-center py-20">
    <div class="container-wide text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl md:text-6xl">
        No pudimos encontrar esa página.
      </h1>
      <p class="mx-auto mt-4 max-w-lg text-lg text-slate-600">
        Es posible que el enlace esté desactualizado o que hayamos reorganizado el sitio. Prueba volver al inicio o visitar nuestras secciones más populares.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/es/" class="btn-primary">Volver al inicio</a>
        <a href="/es/blog/" class="btn-secondary">Leer el blog</a>
        <a href="/es/apps/" class="btn-secondary">Ver los apps</a>
      </div>
    </div>
  </section>
</BaseLayout>
