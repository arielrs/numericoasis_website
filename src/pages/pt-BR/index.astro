---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, PRODUCT_LABELS } from '../../consts';
import { contentSlug } from '../../i18n/paths';

const apps = (await getCollection('apps', ({ data }) => data.lang === 'pt-BR'))
  .filter((a) => a.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog', ({ data }) => data.lang === 'pt-BR' && !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout title={SITE.name} description="Numeric Oasis é uma software house e consultoria. Quinze anos construindo software customizado para times em todo o mundo (SaaS, ferramentas internas, apps mobile e integrações), publicando apps Atlassian Forge no Marketplace, aconselhando sobre processos de negócio e TI, e dando suporte aos times que fazem tudo rodar.">
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-white to-white">
    <div class="absolute inset-0 -z-10 opacity-60" aria-hidden="true">
      <div class="absolute -left-32 top-0 h-[480px] w-[480px] rounded-full bg-water-300/40 blur-3xl"></div>
      <div class="absolute right-0 top-32 h-[420px] w-[420px] rounded-full bg-sun-300/30 blur-3xl"></div>
    </div>

    <div class="container-wide pt-20 pb-24 sm:pt-28 sm:pb-32">
      <p class="eyebrow">Software house · Parceiro Atlassian Marketplace · Consultoria de TI</p>
      <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-slate-900 sm:text-5xl md:text-6xl lg:text-7xl">
        Software, serviços e<br class="hidden md:block" />
        <span class="bg-gradient-to-r from-brand-700 via-water-500 to-sun-500 bg-clip-text text-transparent">15 anos de know-how.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Construímos software customizado para times em todo o mundo: SaaS, ferramentas internas, apps mobile, integrações. Publicamos apps Atlassian Forge no Marketplace. Aconselhamos sobre processos de negócio e TI. E damos suporte aos times que rodam tudo isso.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/pt-BR/contact/" class="btn-primary">
          Iniciar um projeto
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="/pt-BR/apps/" class="btn-secondary">Veja nossos apps</a>
      </div>

      <dl class="mt-16 grid grid-cols-2 gap-8 border-t border-slate-200 pt-10 sm:grid-cols-4">
        {[
          { k: '15 anos', v: 'Construindo e consultando' },
          { k: '1000+', v: 'Softwares customizados entregues' },
          { k: '4+ apps', v: 'Parceiro Atlassian Forge Marketplace' },
          { k: '6 continentes', v: 'Clientes no mundo todo, todos os fusos' },
        ].map(({ k, v }) => (
          <div>
            <dt class="font-display text-3xl font-bold text-slate-900">{k}</dt>
            <dd class="mt-1 text-sm text-slate-500">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-paper-soft py-20 sm:py-28">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="eyebrow">O que fazemos</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Quatro caminhos para ajudar times a construir, operar e melhorar seu software.
        </h2>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {[
          {
            title: 'Software customizado e SaaS',
            desc: 'SaaS do zero, apps web e mobile, integrações e plataformas sob medida. Agnósticos de stack: usamos o que encaixa no problema ou ajudamos a escolher a melhor opção, mais rápida e mais barata.',
            icon: '🛠️',
          },
          {
            title: 'Apps Atlassian e plataforma',
            desc: 'Apps Forge para o Marketplace, plugins customizados, migrações, auditorias e saúde de Jira e Confluence.',
            icon: '🧩',
          },
          {
            title: 'Consultoria de negócios e TI',
            desc: 'ITIL e ITSM, desenho de processo, governança e os rollouts que transformam estratégia em operação que funciona.',
            icon: '🧭',
          },
          {
            title: 'Suporte e serviços gerenciados',
            desc: 'Suporte de longo prazo, SLAs e operação para o software que entregamos e para as plataformas em que você roda.',
            icon: '🎧',
          },
        ].map((s) => (
          <article class="group rounded-2xl border border-slate-200 bg-white p-7 shadow-[var(--shadow-soft)] transition hover:-translate-y-0.5 hover:border-water-300 hover:shadow-lg">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-brand-50 to-water-300/20 text-xl">
              <span aria-hidden="true">{s.icon}</span>
            </div>
            <h3 class="mt-5 font-display text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
          </article>
        ))}
      </div>

      <div class="mt-10">
        <a href="/pt-BR/services/" class="text-sm font-semibold text-water-700 hover:text-water-600">
          Veja todos os serviços →
        </a>
      </div>
    </div>
  </section>

  <!-- WORLDWIDE CUSTOM SOFTWARE -->
  <section class="py-20 sm:py-28">
    <div class="container-wide grid gap-12 lg:grid-cols-[2fr_3fr] lg:items-center">
      <div>
        <p class="eyebrow">Software house · 15 anos</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
          Construímos software customizado para clientes em seis continentes.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-600">
          SaaS, ferramentas internas, customizações e integrações, apps mobile. Se é software, está dentro do nosso escopo. Atendemos clientes em seis continentes e cobrimos todos os fusos no meio do caminho.
        </p>
        <div class="mt-8 flex flex-wrap gap-2">
          {['SaaS', 'Software interno', 'Mobile', 'Integrações', 'Customizações'].map((tag) => (
            <span class="rounded-full border border-sand-200 bg-white px-3.5 py-1.5 text-sm font-medium text-brand-800">{tag}</span>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/pt-BR/services/#custom-software" class="btn-primary">
            Veja nossos serviços
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/pt-BR/contact/" class="btn-secondary">Fale com o time</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          { h: 'SaaS do zero', p: 'Plataformas modernas, hospedadas, totalmente suas. Integrações com o stack que você já usa.' },
          { h: 'Ferramentas internas', p: 'Painéis, automações e fluxos sob medida que tiram horas das suas rotinas.' },
          { h: 'Apps mobile', p: 'Aplicações iOS e Android quando o problema do cliente acontece longe do desktop.' },
          { h: 'Integrações & customizações', p: 'Conectamos sistemas. Estendemos plataformas. Personalizamos sem perder a atualizabilidade.' },
        ].map((c) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-[var(--shadow-soft)]">
            <h3 class="font-display text-lg font-semibold text-brand-900">{c.h}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ATLASSIAN COST REDUCTION TEASER -->
  <section class="bg-gradient-to-br from-brand-50 via-water-50 to-sun-50 py-20 sm:py-28">
    <div class="container-wide grid gap-10 lg:grid-cols-[3fr_2fr] lg:items-center">
      <div>
        <p class="eyebrow">Marketplace → Forge</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl md:text-5xl">
          Reduza o gasto com apps Atlassian, sem perder o workflow.
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700">
          Apps do Marketplace cobram por usuário, para sempre. A gente reconstrói o uso que você realmente faz como apps Forge customizados, que ficam dentro da segurança cloud da Atlassian e são seus. Menos licença, melhor encaixe, mesma confiança.
        </p>
        <div class="mt-8">
          <a href="/pt-BR/atlassian-app-cost-reduction/" class="btn-primary">
            Veja como reduzimos seu custo Atlassian
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
      <ul class="grid gap-3 text-sm text-slate-700">
        {[
          'Por usuário → custo fixo',
          'Sandbox Forge, dentro do seu tenant',
          'Sem trânsito de dados por terceiros',
          'Você é dono do código e do roadmap',
        ].map((b) => (
          <li class="flex items-start gap-3 rounded-xl border border-white/60 bg-white/70 p-4 backdrop-blur">
            <svg class="mt-0.5 shrink-0 text-water-700" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-medium">{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="container-wide">
      <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow">Do Marketplace</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
            Apps usados por times Atlassian.
          </h2>
        </div>
        <a href="/pt-BR/apps/" class="text-sm font-semibold text-water-700 hover:text-water-600">
          Ver todos os apps →
        </a>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {apps.map((app) => (
          <a
            href={`/pt-BR/apps/${contentSlug(app.id)}/`}
            class="group flex flex-col justify-between rounded-2xl border border-sand-200 bg-white p-7 transition hover:-translate-y-0.5 hover:border-water-400 hover:shadow-[var(--shadow-soft)]"
          >
            <div>
              <div class="flex items-center gap-4">
                {app.data.icon ? (
                  <Image
                    src={app.data.icon}
                    alt={`Logo ${app.data.name}`}
                    width={56}
                    height={56}
                    class="h-14 w-14 shrink-0 rounded-xl object-cover ring-1 ring-sand-200"
                  />
                ) : (
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-900 to-brand-700 font-display text-base font-bold text-white">
                    {app.data.name.charAt(0)}
                  </div>
                )}
                <div>
                  <h3 class="font-display text-xl font-semibold text-brand-900 group-hover:text-brand-700">
                    {app.data.name}
                  </h3>
                  <p class="mt-1 text-sm font-medium text-slate-700">{app.data.tagline}</p>
                </div>
              </div>
              <p class="mt-5 line-clamp-4 text-sm leading-relaxed text-slate-600">
                {app.data.description}
              </p>
              {app.data.audiences.length > 0 && (
                <p class="mt-4 text-xs leading-relaxed text-slate-500">
                  <span class="font-semibold text-brand-800">Feito para:</span> {app.data.audiences.join(' · ')}
                </p>
              )}
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold">
              {app.data.products.map((p) => (
                <span class="rounded-full bg-water-50 px-2.5 py-1 text-water-700">{PRODUCT_LABELS[p] ?? p}</span>
              ))}
              {app.data.pricing && /^(free|grátis|gratis|gratuito)$/i.test(app.data.pricing) && (
                <span class="rounded-full bg-sun-50 px-2.5 py-1 text-sun-700">Grátis</span>
              )}
              <span class="ml-auto text-slate-400 transition group-hover:text-water-600">Saiba mais →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="border-t border-slate-200 bg-paper-soft py-20 sm:py-28">
      <div class="container-wide">
        <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
          <div>
            <p class="eyebrow">Do blog</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
              Notas da oficina.
            </h2>
          </div>
          <a href="/pt-BR/blog/" class="text-sm font-semibold text-water-700 hover:text-water-600">
            Todos os posts →
          </a>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/pt-BR/blog/${contentSlug(post.id)}/`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-white transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)]"
            >
              {post.data.heroImage && (
                <div class="aspect-[16/10] overflow-hidden bg-sand-100">
                  <Image
                    src={post.data.heroImage}
                    alt=""
                    width={640}
                    height={400}
                    class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                  {post.data.pubDate.toLocaleDateString('pt-BR', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <h3 class="mt-3 font-display text-lg font-semibold text-brand-900 group-hover:text-brand-700">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600">
                  {post.data.description}
                </p>
                <span class="mt-auto pt-4 text-xs font-semibold text-water-700">Ler post →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-20 sm:py-28">
    <div class="container-wide">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-900 via-brand-800 to-deep-700 p-10 sm:p-16">
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-sun-500/30 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -left-10 bottom-0 h-48 w-48 rounded-full bg-water-400/30 blur-3xl" aria-hidden="true"></div>
        <div class="relative max-w-2xl">
          <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Tem algo para construir, ajustar ou repensar?
          </h2>
          <p class="mt-4 text-lg text-brand-100">
            Conte para a gente. Respondemos em até um dia útil com uma visão honesta e, se for o nosso caixote, um caminho para frente.
          </p>
          <a href="/pt-BR/contact/" class="mt-8 inline-flex btn-primary !bg-white !text-brand-900 hover:!bg-brand-50">
            Comece a conversa
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
