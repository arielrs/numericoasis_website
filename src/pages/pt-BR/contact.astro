---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
---

<BaseLayout
  title="Contato"
  description={`Fale com a Numeric Oasis. Respondemos em até um dia útil. ${SITE.email}`}
>
  <section class="bg-gradient-to-b from-slate-50 to-white py-20 sm:py-28">
    <div class="container-wide">
      <p class="eyebrow">Contato</p>
      <h1 class="mt-3 max-w-4xl font-display text-4xl font-bold leading-tight tracking-tight text-slate-900 sm:text-5xl md:text-6xl">
        Conte para a gente o que você está construindo.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
        Respondemos em até um dia útil. Se a gente não for a melhor opção, falamos. E, quando der, indicamos quem é.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-20">
    <div class="container-wide grid gap-10 md:grid-cols-5">
      <div class="md:col-span-2">
        <h2 class="font-display text-xl font-semibold text-slate-900">Contato direto</h2>
        <ul class="mt-5 space-y-4 text-sm">
          <li>
            <p class="text-slate-500">E-mail</p>
            <a class="font-medium text-slate-900 hover:text-water-600" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li>
            <p class="text-slate-500">Marketplace</p>
            <a class="font-medium text-slate-900 hover:text-water-600" href={SITE.marketplaceUrl} rel="noopener" target="_blank">Veja nossos apps →</a>
          </li>
          {SITE.linkedin && (
            <li>
              <p class="text-slate-500">LinkedIn</p>
              <a class="font-medium text-slate-900 hover:text-water-600" href={SITE.linkedin} rel="noopener" target="_blank">@numericoasis →</a>
            </li>
          )}
          <li>
            <p class="text-slate-500">Localização</p>
            <p class="font-medium text-slate-900">{SITE.location}</p>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <form
          action={`mailto:${SITE.email}`}
          method="post"
          enctype="text/plain"
          class="rounded-3xl border border-slate-200 bg-white p-8 shadow-[var(--shadow-soft)]"
        >
          <h2 class="font-display text-xl font-semibold text-slate-900">Mande uma mensagem</h2>
          <p class="mt-1 text-sm text-slate-500">
            Ao enviar, seu cliente de e-mail será aberto. Prefere um formulário com back-end? <a class="text-water-700 underline underline-offset-4" href={`mailto:${SITE.email}`}>Pode escrever direto para a gente.</a>
          </p>

          <div class="mt-6 grid gap-4">
            <label class="grid gap-1.5 text-sm font-medium text-slate-800">
              Seu nome
              <input type="text" name="name" required class="rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-water-500 focus:ring-2 focus:ring-water-500/30" />
            </label>
            <label class="grid gap-1.5 text-sm font-medium text-slate-800">
              E-mail
              <input type="email" name="email" required class="rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-water-500 focus:ring-2 focus:ring-water-500/30" />
            </label>
            <label class="grid gap-1.5 text-sm font-medium text-slate-800">
              Empresa (opcional)
              <input type="text" name="company" class="rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-water-500 focus:ring-2 focus:ring-water-500/30" />
            </label>
            <label class="grid gap-1.5 text-sm font-medium text-slate-800">
              Como podemos ajudar?
              <textarea name="message" rows="5" required class="rounded-lg border border-slate-200 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-water-500 focus:ring-2 focus:ring-water-500/30"></textarea>
            </label>
            <button type="submit" class="btn-primary mt-2 w-full justify-center">Enviar →</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
