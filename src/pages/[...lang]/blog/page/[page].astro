---
/**
 * Blog pagination, page two onwards. Page one stays at /blog/.
 *
 * A separate route rather than turning the index into `[...page]`: that would
 * put two rest routes in the same directory alongside `[...slug]`, which
 * generates disjoint paths in a static build but is genuinely ambiguous, and
 * the blog index is not the route to be clever on.
 *
 * Generates nothing until there are more posts than fit on one page.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import { LOCALES, DEFAULT_LOCALE, withLocale, type Locale } from '../../../../i18n';
import { blog } from '../../../../i18n/pages/blog';
import { POSTS_PER_PAGE } from '../../../../lib/blog';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    const posts = (
      await getCollection('blog', ({ data }) => data.lang === lang && !data.draft)
    ).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({
        params: { lang: lang === DEFAULT_LOCALE ? undefined : lang, page: String(page) },
        props: {
          lang,
          page,
          totalPages,
          posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        },
      });
    }
  }
  return paths;
}

const { lang, page, totalPages, posts } = Astro.props;
const t = blog[lang as Locale];

const prevHref = page === 2 ? '/blog/' : `/blog/page/${page - 1}/`;
---

<BaseLayout
  title={`${t.meta.title} ${t.pagination.page(page, totalPages)}`}
  description={t.meta.description}
  graph={{
    breadcrumbs: [
      { name: t.meta.crumb, path: '/blog/' },
      { name: t.pagination.page(page, totalPages), path: `/blog/page/${page}/` },
    ],
    pageType: 'CollectionPage',
  }}
>
  <section class="border-b border-sand-200 bg-sand-50 py-14 sm:py-16">
    <div class="container-wide">
      <p class="eyebrow">{t.index.eyebrow}</p>
      <h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
        {t.index.headline}
      </h1>
      <p class="mt-4 text-sm text-slate-600">{t.pagination.page(page, totalPages)}</p>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="container-wide">
      <div class="grid gap-6 md:grid-cols-3">
        {posts.map((post) => <PostCard post={post} lang={lang as Locale} />)}
      </div>

      <nav class="mt-12 flex items-center justify-between gap-4" aria-label={t.pagination.label}>
        <a
          href={withLocale(lang, prevHref)}
          class="inline-flex items-center gap-1.5 rounded-md text-sm font-semibold text-water-700 transition hover:text-water-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 19l-7-7 7-7" /></svg>
          {t.pagination.previous}
        </a>
        {page < totalPages && (
          <a
            href={withLocale(lang, `/blog/page/${page + 1}/`)}
            class="inline-flex items-center gap-1.5 rounded-md text-sm font-semibold text-water-700 transition hover:text-water-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
          >
            {t.pagination.next}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
          </a>
        )}
      </nav>
    </div>
  </section>
</BaseLayout>
