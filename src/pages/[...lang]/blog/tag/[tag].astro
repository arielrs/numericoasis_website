---
/**
 * Tag archives.
 *
 * Generated for every tag in every locale, even where a locale has no post yet.
 * SEO.astro derives its hreflang alternates from the path alone and cannot know
 * whether a sibling exists, so a locale-conditional archive would advertise
 * alternates that 404. An empty archive with an honest message is cheaper than
 * a broken hreflang cluster.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import { SITE } from '../../../../consts';
import {
  LOCALES,
  DEFAULT_LOCALE,
  contentSlug,
  withLocale,
  type Locale,
} from '../../../../i18n';
import { blog } from '../../../../i18n/pages/blog';
import { BLOG_TAGS, type BlogTag } from '../../../../content.config';
import { WEBSITE_ID, type JsonLdNode } from '../../../../lib/schema';

export async function getStaticPaths() {
  const published = await getCollection('blog', ({ data }) => !data.draft);
  const used = new Set(published.flatMap((p) => p.data.tags));

  return LOCALES.flatMap((lang) =>
    BLOG_TAGS.filter((tag) => used.has(tag)).map((tag) => ({
      params: { lang: lang === DEFAULT_LOCALE ? undefined : lang, tag },
      props: { lang, tag },
    })),
  );
}

const { lang, tag } = Astro.props as { lang: Locale; tag: BlogTag };
const t = blog[lang];
const label = t.tags[tag];

const posts = (
  await getCollection(
    'blog',
    ({ data }) => data.lang === lang && !data.draft && data.tags.includes(tag),
  )
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const canonical = new URL(withLocale(lang, `/blog/tag/${tag}/`), SITE.url).toString();

const itemList: JsonLdNode = {
  '@type': 'ItemList',
  '@id': `${canonical}#postlist`,
  name: `${t.tagPage.headlinePrefix} ${label}`,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: posts.length,
  isPartOf: { '@id': WEBSITE_ID },
  itemListElement: posts.map((post, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: post.data.title,
    url: new URL(withLocale(lang, `/blog/${contentSlug(post.id)}/`), SITE.url).toString(),
  })),
};
---

<BaseLayout
  title={`${t.tagPage.headlinePrefix} ${label}`}
  description={`${t.tagPage.headlinePrefix} ${label}. ${t.meta.description}`}
  graph={{
    breadcrumbs: [
      { name: t.meta.crumb, path: '/blog/' },
      { name: label, path: `/blog/tag/${tag}/` },
    ],
    extraNodes: [itemList],
    primaryEntityId: `${canonical}#postlist`,
    pageType: 'CollectionPage',
  }}
>
  <section class="border-b border-sand-200 bg-sand-50 py-16 sm:py-20">
    <div class="container-wide">
      <a
        href={withLocale(lang, '/blog/')}
        class="inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-slate-600 transition hover:text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 19l-7-7 7-7" /></svg>
        {t.tagPage.backToBlog}
      </a>
      <p class="eyebrow mt-8">{t.tagPage.eyebrow}</p>
      <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-brand-900 sm:text-4xl md:text-5xl">
        {t.tagPage.headlinePrefix} {label}
      </h1>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="container-wide">
      {posts.length === 0 ? (
        <p class="text-base text-slate-600">{t.tagPage.empty}</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
