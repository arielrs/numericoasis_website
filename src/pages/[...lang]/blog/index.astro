---
/**
 * Blog index, page one, for all three locales.
 *
 * The tag row used to be a client-side filter that toggled display on cards, so
 * a topic could not be linked, shared or crawled. It is now a row of links to
 * real tag archives, which deletes the JS and makes the topics indexable.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE } from '../../../consts';
import { localeStaticPaths, contentSlug, withLocale, type Locale } from '../../../i18n';
import { blog } from '../../../i18n/pages/blog';
import { WEBSITE_ID, ORG_ID, type JsonLdNode } from '../../../lib/schema';
import { POSTS_PER_PAGE } from '../../../lib/blog';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = blog[lang];

const allPosts = (
  await getCollection('blog', ({ data }) => data.lang === lang && !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const posts = allPosts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));

// Tags are generated across every locale, so the archive set is identical in
// all three and the hreflang cluster never points at a page that does not exist.
const everyPost = await getCollection('blog', ({ data }) => !data.draft);
const tags = Array.from(new Set(everyPost.flatMap((p) => p.data.tags))).sort();

const canonical = new URL(withLocale(lang, '/blog/'), SITE.url).toString();

const blogNode: JsonLdNode = {
  '@type': 'Blog',
  '@id': `${canonical}#blog`,
  name: `${SITE.name} Blog`,
  url: canonical,
  description: t.meta.description,
  publisher: { '@id': ORG_ID },
  isPartOf: { '@id': WEBSITE_ID },
};

const itemList: JsonLdNode = {
  '@type': 'ItemList',
  '@id': `${canonical}#postlist`,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: allPosts.length,
  itemListElement: posts.map((post, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: post.data.title,
    url: new URL(withLocale(lang, `/blog/${contentSlug(post.id)}/`), SITE.url).toString(),
  })),
};
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  graph={{
    breadcrumbs: [{ name: t.meta.crumb, path: '/blog/' }],
    extraNodes: [blogNode, itemList],
    primaryEntityId: `${canonical}#blog`,
    pageType: 'CollectionPage',
  }}
>
  <section class="border-b border-sand-200 bg-sand-50 py-16 sm:py-24">
    <div class="container-wide">
      <p class="eyebrow">{t.index.eyebrow}</p>
      <h1 class="mt-3 max-w-4xl font-display text-4xl font-bold leading-tight tracking-tight text-brand-900 sm:text-5xl md:text-6xl">
        {t.index.headline}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">{t.index.lede}</p>

      {tags.length > 0 && (
        <nav class="mt-8" aria-label={t.index.tagsLabel}>
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <a
                  href={withLocale(lang, `/blog/tag/${tag}/`)}
                  class="inline-block rounded-full border border-sand-200 bg-paper px-3.5 py-1.5 text-sm font-medium text-brand-800 transition hover:border-water-400 hover:text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
                >
                  {t.tags[tag]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="container-wide">
      {posts.length === 0 ? (
        <p class="text-base text-slate-600">{t.index.empty}</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-3">
          {posts.map((post, i) => (
            <PostCard post={post} lang={lang} wide={i === 0} />
          ))}
        </div>
      )}

      {totalPages > 1 && (
        <nav class="mt-12 flex items-center justify-between" aria-label={t.pagination.label}>
          <span class="text-sm text-slate-500">{t.pagination.page(1, totalPages)}</span>
          <a
            href={withLocale(lang, '/blog/page/2/')}
            class="inline-flex items-center gap-1.5 rounded-md text-sm font-semibold text-water-700 transition hover:text-water-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
          >
            {t.pagination.next}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
          </a>
        </nav>
      )}
    </div>
  </section>
</BaseLayout>
