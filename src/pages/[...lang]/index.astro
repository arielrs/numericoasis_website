---
/**
 * The home page for all three locales.
 *
 * The company leads, then the app we are currently pushing, then the range.
 * An earlier version opened with an OnBudget headline and an OnBudget
 * screenshot, which read as a product landing page with a company footer. The
 * hero is now about Numeric Oasis, and OnBudget owns the section immediately
 * below it, framed as where attention is right now rather than as a permanent
 * ranking, since more apps are coming.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCard from '../../components/AppCard.astro';
import { outbound } from '../../lib/outbound';
import HeroCanvas from '../../components/HeroCanvas.astro';
import PostCard from '../../components/PostCard.astro';
import { localeStaticPaths, contentSlug, withLocale, type Locale } from '../../i18n';
import { home } from '../../i18n/pages/home';
import { words, wordDelay } from '../../lib/words';
import { appsIndex } from '../../i18n/pages/apps-index';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = home[lang];
const nav = appsIndex[lang];

const apps = (await getCollection('apps', ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const focusApp = apps.find((a) => a.data.flagship);
const jira = apps.filter((a) => a.data.hostProducts.includes('jira'));
const confluence = apps.filter((a) => a.data.hostProducts.includes('confluence'));

// Two shots, not one. The portfolio grid says "many budgets"; the report view
// is the only frame on the page that shows what OnBudget actually produces,
// which is the health gauge, planned versus actual, and spend over time. Both
// already exist and render on /onbudget/.
const focusShots = (['hero', 'report-at-risk'] as const)
  .map((slot) => focusApp?.data.screenshots.find((s) => s.slot === slot))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

// The two shots are 922x795 and 940x858, so at equal width the second rendered
// 29px taller and the captions did not line up. They now share the taller of
// the two ratios and letterbox rather than crop, because cropping 6 percent off
// a screenshot takes a chart axis with it. Both screenshots sit on white, so
// the padding is invisible against bg-paper.
//
// Inline, not a Tailwind class, on purpose. Astro injects
// :where([data-astro-image]){height:auto} and [data-astro-image-fit=...] after
// every cascade layer closes, so a layered utility loses to them whatever its
// specificity. See the note in src/styles/global.css. An inline style outranks
// both, and with width:100% the height follows from the ratio.
const shotAspect = focusShots.length
  ? Math.min(...focusShots.map((s) => s.image.width / s.image.height))
  : undefined;
const shotStyle = shotAspect
  ? `aspect-ratio: ${shotAspect}; object-fit: contain;`
  : undefined;

// Written and translated in the app's own frontmatter, and rendered nowhere:
// the flagship is excluded from the /apps/<slug>/ route that would show them.
const focusProps = focusApp?.data.valueProps ?? [];

// Edit mode, for the customisation block.
const editShot = focusApp?.data.screenshots.find((s) => s.slot === 'edit-layout');

const posts = (
  await getCollection('blog', ({ data }) => data.lang === lang && !data.draft)
)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const cardLabels = { builtFor: nav.builtFor, readMore: nav.readMore };

const appHref = (app: (typeof apps)[number]) =>
  withLocale(lang, app.data.landingPath ?? `/apps/${contentSlug(app.id)}/`);

const arrow =
  '<path d="M5 12h14M13 5l7 7-7 7" />';
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  metaDescription={t.meta.metaDescription}
>
  <!-- 1. HERO: the company, not a product.
       The canvas is decorative and sits behind everything; the section is
       `relative` only so it has something to anchor to, and `overflow-hidden`
       keeps the waves from painting over the section border. -->
  <section class="relative overflow-hidden border-b border-sand-200 bg-sand-50">
    <HeroCanvas />
    <div class="container-wide relative grid gap-14 py-16 sm:py-24 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-20">
      <div data-enter="words">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <!-- Split per word so the headline assembles itself rather than
             appearing. The split is done here, at build time, so the spans are
             in the HTML and no script is involved.

             The space sits BETWEEN the spans, not inside them. A trailing space
             inside an inline-block is collapsed away, which left innerText as
             "TheAtlassianappswekeptwishingexisted" and broke copy and paste
             entirely. The reference site papers over the visual half of that
             with margin-right; a real text node fixes both halves. -->
        <h1
          data-words
          class="mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.08] tracking-tight text-brand-900 sm:text-5xl md:text-6xl"
        >
          {words(t.hero.headline).map((word, i) => (
            <>
              <span class="hero-word" style={`--word-delay: ${wordDelay(i)}ms`}>{word}</span>{' '}
            </>
          ))}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">{t.hero.lede}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={withLocale(lang, '/apps/')} class="btn-cta">
            {t.hero.primary}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
          </a>
          <a href={withLocale(lang, '/about/')} class="btn-secondary">{t.hero.secondary}</a>
        </div>
      </div>

      <!-- The range at a glance. Our own products, so this is not a borrowed
           trust signal, and it says "app vendor" rather than "one app". -->
      <nav class="enter" style="--enter-delay: 1650ms" aria-label={t.hero.iconsLabel}>
        <ul class="grid grid-cols-3 gap-3 sm:gap-4">
          {apps.map((app, i) => (
            <li class="animate-float" style={`animation-delay: ${i * 620}ms`}>
              <a
                href={appHref(app)}
                class="group flex aspect-square items-center justify-center rounded-2xl border border-sand-200 bg-paper p-4 transition duration-200 ease-out-soft hover:-translate-y-1 hover:border-water-400 hover:shadow-[var(--shadow-soft)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
              >
                {app.data.icon && (
                  <Image
                    src={app.data.icon}
                    alt={app.data.name}
                    width={96}
                    class="h-full w-full rounded-xl object-cover"
                    loading="eager"
                  />
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- 2. PROOF STRIP: six reasons to trust us, not six facts about our stack.
       The heading was an invisible aria-label reading "How our apps are built",
       which told the reader the row was about us. It is now visible, and says
       what our own Marketplace listings say over the same facts. -->
  <section class="border-b border-sand-200 bg-paper py-8">
    <div class="container-wide">
      <h2 class="eyebrow reveal text-center" data-reveal-words>
        {words(t.proof.label).map((word, i) => (
          <>
            <span class="hero-word" style={`--word-delay: ${wordDelay(i, 0, 90)}ms`}>{word}</span>{' '}
          </>
        ))}
      </h2>
      <ul
        class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs font-semibold uppercase tracking-[0.14em] text-brand-700"
        data-reveal-group
      >
        {t.proof.items.map((item) => (
          <li class="reveal flex items-center gap-2">
            <svg class="text-water-600" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. ONBUDGET: the app we lead with, given the room to actually sell.
       This used to be one screenshot, two hedged paragraphs and a text link.
       It now shows what a report looks like and closes with a real CTA. -->
  <section class="bg-sand-50 py-16 sm:py-24">
    <div class="container-wide">
      <div class="max-w-3xl" data-reveal-group>
        <p class="eyebrow" data-reveal-words>
          {words(t.focus.eyebrow).map((word, i) => (
            <>
              <span class="hero-word" style={`--word-delay: ${wordDelay(i, 0, 90)}ms`}>{word}</span>{' '}
            </>
          ))}
        </p>
        <h2
          class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl"
          data-reveal-words
        >
          {words(t.focus.headline).map((word, i) => (
            <>
              <span class="hero-word" style={`--word-delay: ${wordDelay(i, 0, 110)}ms`}>{word}</span>{' '}
            </>
          ))}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-700">{t.focus.lede}</p>
      </div>

      {focusShots.length > 0 && (
        <div class="mt-12 grid gap-8 lg:grid-cols-2" data-reveal-group>
          {focusShots.map((shot) => (
            <figure class="reveal">
              <Image
                src={shot.image}
                alt={shot.alt ?? shot.caption}
                width={960}
                sizes="(min-width: 1024px) 620px, 100vw"
                class="w-full rounded-2xl border border-sand-200 bg-paper"
                style={shotStyle}
                loading="lazy"
              />
              <figcaption class="mt-3 px-1 text-sm leading-relaxed text-slate-600">
                {shot.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      {focusProps.length > 0 && (
        <ul class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
          {focusProps.map((vp) => (
            <li class="reveal rounded-2xl border border-sand-200 bg-paper p-6 transition duration-200 ease-out-soft hover:-translate-y-1 hover:border-water-400 hover:shadow-[var(--shadow-soft)]">
              {vp.icon && <p class="text-2xl" aria-hidden="true">{vp.icon}</p>}
              <h3 class="mt-3 font-display text-lg font-semibold tracking-tight text-brand-900">
                {vp.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{vp.body}</p>
            </li>
          ))}
        </ul>
      )}

      {editShot && (
        <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-14" data-reveal-group>
          <div class="reveal">
            <h3 class="font-display text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">
              {t.focus.custom.title}
            </h3>
            <p class="mt-5 text-base leading-relaxed text-slate-700">{t.focus.custom.report}</p>
            <p class="mt-4 text-base leading-relaxed text-slate-700">{t.focus.custom.dashboard}</p>
          </div>
          <figure class="reveal">
            <Image
              src={editShot.image}
              alt={editShot.alt ?? editShot.caption}
              width={1007}
              sizes="(min-width: 1024px) 700px, 100vw"
              class="w-full rounded-2xl border border-sand-200 bg-paper"
              loading="lazy"
            />
            <figcaption class="mt-3 px-1 text-sm leading-relaxed text-slate-600">
              {editShot.caption}
            </figcaption>
          </figure>
        </div>
      )}

      <div class="mt-14 flex flex-wrap gap-3">
        <a href={withLocale(lang, '/onbudget/')} class="btn-cta">
          {t.focus.ctaPrimary}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
        </a>
        {focusApp?.data.marketplaceUrl && (
          <a
            href={outbound(focusApp.data.marketplaceUrl, 'home', 'focus-section')}
            class="btn-secondary"
            rel="noopener"
            target="_blank"
          >{t.focus.ctaSecondary}</a>
        )}
      </div>
    </div>
  </section>

  <!-- 4. THE RANGE: grouped by host, so half is skippable at a glance -->
  <section class="border-y border-sand-200 bg-sand-50 py-16 sm:py-24">
    <div class="container-wide">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">{t.portfolio.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.portfolio.headline}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{t.portfolio.lede}</p>
      </div>

      <h3 class="eyebrow mt-12">{nav.groups.jira}</h3>
      <div class="mt-6 grid gap-6 md:grid-cols-2" data-reveal-group>
        {jira.map((app) => (
          <AppCard app={app} lang={lang} labels={cardLabels} wide={app.data.flagship} surface="home" reveal />
        ))}
      </div>

      <h3 class="eyebrow mt-14">{nav.groups.confluence}</h3>
      <div class="mt-6 grid gap-6 md:grid-cols-2" data-reveal-group>
        {confluence.map((app) => (
          <AppCard app={app} lang={lang} labels={cardLabels} surface="home" reveal />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. HOW WE WORK: prose, not cards -->
  <section class="py-16 sm:py-24">
    <div class="container-wide grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] lg:gap-16">
      <div>
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.how.headline}
        </h2>
      </div>
      <div>
        {t.how.paragraphs.map((paragraph) => (
          <p class="mb-5 text-base leading-relaxed text-slate-600 last:mb-0">{paragraph}</p>
        ))}
        <p class="mt-7">
          <a
            href={withLocale(lang, '/about/')}
            class="inline-flex items-center gap-1.5 rounded-md text-sm font-semibold text-water-700 transition hover:text-water-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
          >
            {t.how.link}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- 6. FROM THE BLOG: 2 + 1, not three identical cards -->
  {posts.length > 0 && (
    <section class="border-t border-sand-200 py-16 sm:py-24">
      <div class="container-wide">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">{t.blog.eyebrow}</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
              {t.blog.headline}
            </h2>
          </div>
          <a
            href={withLocale(lang, '/blog/')}
            class="inline-flex items-center gap-1.5 rounded-md text-sm font-semibold text-water-700 transition hover:text-water-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
          >
            {t.blog.link}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
          </a>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-3" data-reveal-group>
          {posts.map((post) => <PostCard post={post} lang={lang} reveal />)}
        </div>
      </div>
    </section>
  )}

  <!-- 7. CTA -->
  <section class="pb-16 sm:pb-24">
    <div class="container-wide">
      <div class="reveal rounded-3xl bg-brand-900 p-10 sm:p-16">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
            {t.cta.headline}
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-brand-100">{t.cta.body}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={withLocale(lang, '/apps/')} class="btn-cta">{t.cta.primary}</a>
            <a href={withLocale(lang, '/contact/')} class="btn-secondary !bg-paper">{t.cta.secondary}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
