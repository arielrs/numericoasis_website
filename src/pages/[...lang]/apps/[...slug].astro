---
/**
 * One route file for every app detail page in every locale.
 *
 * The flagship is excluded: it has its own top-level landing page, and two
 * indexable pages for one product would split inbound links and give search
 * engines two candidates for the same query. /apps/onbudget/ redirects there.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CapabilityStrip from '../../../components/CapabilityStrip.astro';
import { SITE, PRODUCT_LABELS } from '../../../consts';
import {
  LOCALES,
  DEFAULT_LOCALE,
  BCP47_MAP,
  contentSlug,
  withLocale,
  useTranslations,
  type Locale,
} from '../../../i18n';
import { appDetail } from '../../../i18n/pages/app-detail';
import { appsIndex } from '../../../i18n/pages/apps-index';
import { ORG_ID, WEBSITE_ID, type JsonLdNode } from '../../../lib/schema';
import { outbound } from '../../../lib/outbound';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    const apps = await getCollection(
      'apps',
      ({ data }) => data.lang === lang && !data.flagship,
    );
    for (const app of apps) {
      paths.push({
        params: {
          lang: lang === DEFAULT_LOCALE ? undefined : lang,
          slug: contentSlug(app.id),
        },
        props: { app, lang },
      });
    }
  }
  return paths;
}

const { app, lang } = Astro.props;
const t = appDetail[lang as Locale];
const nav = appsIndex[lang as Locale];
const chrome = useTranslations(lang as Locale);
// Short enough for a 40px header button, unlike installOnMarketplace.
const chromeCta = chrome.apps.viewOnMarketplace;
const slug = contentSlug(app.id);
const d = app.data;

const pageUrl = new URL(withLocale(lang, `/apps/${slug}/`), SITE.url).toString();
const appId = `${pageUrl}#software`;
const isFree = d.priceModel === 'free';

const softwareNode: JsonLdNode = {
  '@type': 'SoftwareApplication',
  '@id': appId,
  name: d.listingName ?? d.name,
  alternateName: d.name,
  description: d.description,
  abstract: d.tagline,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'AtlassianMarketplaceApp',
  operatingSystem: 'Atlassian Cloud',
  url: pageUrl,
  inLanguage: BCP47_MAP[lang as Locale],
  isPartOf: { '@id': WEBSITE_ID },
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  // A reference, not a second Organization node with the same facts.
  publisher: { '@id': ORG_ID },
  provider: { '@id': ORG_ID },
  ...(d.version && { softwareVersion: d.version }),
  ...(d.dateModified && { dateModified: d.dateModified.toISOString().slice(0, 10) }),
  ...(d.keyFeatures.length > 0 && { featureList: [...d.keyFeatures] }),
  ...(d.audiences.length > 0 && {
    audience: d.audiences.map((a) => ({ '@type': 'Audience', audienceType: a })),
  }),
  ...(d.marketplaceUrl && {
    downloadUrl: d.marketplaceUrl,
    installUrl: d.marketplaceUrl,
    sameAs: [d.marketplaceUrl],
  }),
  ...(d.screenshots.length > 0 && {
    screenshot: d.screenshots.slice(0, 5).map((s) => ({
      '@type': 'ImageObject',
      url: new URL(s.image.src, SITE.url).toString(),
      width: s.image.width,
      height: s.image.height,
      caption: s.caption,
    })),
  }),
  // A free app can carry a valid Offer. A paid one cannot without publishing a
  // price, and an Offer with only a description is invalid, so it gets none.
  ...(isFree && {
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      seller: { '@id': ORG_ID },
      ...(d.marketplaceUrl && { url: d.marketplaceUrl }),
    },
  }),
  // aggregateRating is deliberately absent. Google requires the review content
  // to be rendered on the page, forbids a business marking up its own aggregate
  // rating, and a valid node needs a review count we do not publish.
};

/**
 * FAQ, on the non-flagship route too.
 *
 * The flagship carried an eight entry FAQ, rendered it, and emitted a FAQPage
 * node. The other five apps have the same `faq` field on the collection, with
 * the same shape and a default of [], and neither rendered it nor described it.
 * The slot existing without being used is why the copy work for those apps was
 * blocked on a template change rather than on writing.
 *
 * Note this is NOT justified by rich results: Google restricted FAQ rich
 * results in 2023. It is justified by the visible content, and by giving an
 * answer engine a question and its answer as one addressable unit.
 */
const faqNode: JsonLdNode | undefined =
  d.faq.length > 0
    ? {
        '@type': 'FAQPage',
        '@id': `${pageUrl}#faq`,
        mainEntity: d.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : undefined;
---

<BaseLayout
  navCta={d.marketplaceUrl
    ? { href: outbound(d.marketplaceUrl, slug, 'nav'), label: chromeCta, external: true }
    : undefined}
  title={d.metaTitle ?? d.name}
  description={d.description}
  metaDescription={d.metaDescription}
  image={d.icon}
  graph={{
    breadcrumbs: [
      { name: nav.meta.crumb, path: '/apps/' },
      { name: d.name, path: `/apps/${slug}/` },
    ],
    extraNodes: faqNode ? [softwareNode, faqNode] : [softwareNode],
    primaryEntityId: appId,
    pageType: 'ItemPage',
  }}
>
  <!-- HERO -->
  <section class="border-b border-sand-200 bg-sand-50">
    <div class="container-wide pt-12 pb-16 sm:pt-16 sm:pb-20">
      <a
        href={withLocale(lang, '/apps/')}
        class="inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-slate-600 transition hover:text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 19l-7-7 7-7" /></svg>
        {t.backToApps}
      </a>

      <div class="mt-8 grid gap-10 lg:grid-cols-[auto_1fr] lg:items-start lg:gap-14">
        {d.icon && (
          <Image
            src={d.icon}
            alt=""
            width={140}
            class="h-28 w-28 shrink-0 rounded-3xl object-cover ring-1 ring-sand-200 sm:h-32 sm:w-32"
            priority
          />
        )}
        <div data-enter>
          <p class="eyebrow">{t.eyebrow}</p>
          <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight text-brand-900 sm:text-5xl md:text-6xl">
            {d.name}
            {d.descriptor && (
              <span class="mt-3 block font-display text-xl font-semibold leading-snug text-brand-700 sm:text-2xl md:text-3xl">
                {d.descriptor}
              </span>
            )}
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700">{d.description}</p>

          <div class="mt-7 flex flex-wrap items-center gap-2">
            {d.products.map((p) => (
              <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
                {PRODUCT_LABELS[p] ?? p}
              </span>
            ))}
            <span class="rounded-full bg-water-100 px-3 py-1 text-xs font-semibold text-water-700">
              {isFree ? chrome.apps.priceFree : chrome.apps.priceTrial}
            </span>
          </div>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            {d.marketplaceUrl && (
              <a href={outbound(d.marketplaceUrl, slug, 'hero')} class="btn-cta" rel="noopener" target="_blank">
                {t.install}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M7 7h10v10" /></svg>
              </a>
            )}
            <a href={withLocale(lang, '/contact/')} class="btn-secondary">{t.talkToUs}</a>
            {d.documentationUrl && (
              <a href={d.documentationUrl} class="btn-secondary">{t.docs}</a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST SIGNALS -->
  <CapabilityStrip items={d.trustSignals} />

  <!-- VALUE PROPS: first one wide, so this is not three identical cards -->
  {d.valueProps.length > 0 && (
    <section class="bg-sand-50 py-16 sm:py-24">
      <div class="container-wide">
        <div class="max-w-2xl">
          <p class="eyebrow">{t.valueProps.eyebrow} {d.name}</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
            {t.valueProps.headline}
          </h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2" data-reveal-group>
          {d.valueProps.map((vp, i) => (
            <article
              class:list={[
                'rounded-2xl border border-sand-200 bg-paper p-7 transition duration-150 hover:shadow-[var(--shadow-soft)]',
                i === 0 && d.valueProps.length > 2 && 'md:col-span-2 md:flex md:items-start md:gap-7',
              ]}
            >
              {vp.icon && <div class="text-3xl" aria-hidden="true">{vp.icon}</div>}
              <div>
                <h3 class="mt-4 font-display text-xl font-semibold tracking-tight text-brand-900 md:mt-0">
                  {vp.title}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-slate-600">{vp.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FEATURE GROUPS -->
  {d.featureGroups.length > 0 && (
    <section class="py-16 sm:py-24">
      <div class="container-wide grid gap-10 md:grid-cols-2">
        {d.featureGroups.map((group) => (
          <div>
            <h2 class="font-display text-xl font-semibold tracking-tight text-brand-900">{group.name}</h2>
            {group.blurb && <p class="mt-2 text-sm leading-relaxed text-slate-600">{group.blurb}</p>}
            <ul class="mt-4 space-y-2">
              {group.items.map((item) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
                  <svg class="mt-1 shrink-0 text-water-600" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- KEY FEATURES + AUDIENCES -->
  {(d.keyFeatures.length > 0 || d.audiences.length > 0) && (
    <section class="border-t border-sand-200 py-16 sm:py-24">
      <div class="container-wide grid gap-12 md:grid-cols-2">
        {d.keyFeatures.length > 0 && (
          <div>
            <p class="eyebrow">{t.features.eyebrow}</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">
              {t.features.headline}
            </h2>
            <ul class="mt-6 flex flex-wrap gap-2">
              {d.keyFeatures.map((f) => (
                <li class="rounded-full border border-sand-200 bg-paper px-3.5 py-1.5 text-sm font-medium text-brand-800">{f}</li>
              ))}
            </ul>
          </div>
        )}
        {d.audiences.length > 0 && (
          <div>
            <p class="eyebrow">{t.audiences.eyebrow}</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">
              {t.audiences.headline}
            </h2>
            <ul class="mt-6 flex flex-wrap gap-2">
              {d.audiences.map((a) => (
                <li class="rounded-full bg-water-50 px-3.5 py-1.5 text-sm font-medium text-water-700">{a}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- SCREENSHOT GALLERY -->
  {d.screenshots.length > 0 && (
    <section class="bg-sand-50 py-16 sm:py-24">
      <div class="container-wide">
        <div class="max-w-2xl">
          <p class="eyebrow">{t.gallery.eyebrow}</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
            {d.name} {t.gallery.headlineSuffix}
          </h2>
        </div>
        <ul class="mt-12 grid gap-6 md:grid-cols-2" data-reveal-group>
          {d.screenshots.map((shot, i) => (
            <li class:list={[i === 0 && d.screenshots.length > 1 ? 'md:col-span-2' : '']}>
              <button
                type="button"
                class="group block w-full overflow-hidden rounded-2xl border border-sand-200 bg-paper text-left transition duration-150 hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
                data-lightbox-trigger
                data-caption={shot.caption}
                data-full={shot.image.src}
                aria-label={`${t.gallery.openLabel}: ${shot.alt ?? shot.caption}`}
              >
                <div class="relative">
                  <Image
                    src={shot.image}
                    alt={shot.alt ?? shot.caption}
                    width={1280}
                    sizes={i === 0 && d.screenshots.length > 1
                      ? '(min-width: 1280px) 1200px, 100vw'
                      : '(min-width: 768px) 50vw, 100vw'}
                    class="block w-full"
                    loading="lazy"
                  />
                  <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-brand-900/85 px-3 py-1.5 text-xs font-semibold text-white opacity-0 transition group-hover:opacity-100">
                    {t.gallery.enlarge}
                  </span>
                </div>
              </button>
              <p class="mt-3 px-1 text-sm leading-relaxed text-slate-600">{shot.caption}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- DATA AND PERMISSIONS -->
  {d.dataStatement && (
    <section class="py-16 sm:py-24">
      <div class="container-wide max-w-3xl">
        <p class="eyebrow">{t.data.eyebrow}</p>
        <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">
          {t.data.headline}
        </h2>
        {d.dataStatement && (
          <p class="mt-5 text-base leading-relaxed text-slate-600">{d.dataStatement}</p>
        )}
      </div>
    </section>
  )}

  {d.useCases.length > 0 && (
    <section class="border-t border-sand-200 py-16 sm:py-24">
      <div class="container-wide max-w-4xl">
        <p class="eyebrow">{t.useCases.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.useCases.headline}
        </h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal-group>
          {d.useCases.map((useCase) => (
            <article class="reveal rounded-2xl border border-sand-200 bg-paper p-7">
              <h3 class="font-display text-lg font-semibold text-brand-900">{useCase.persona}</h3>
              <p class="mt-3 text-base leading-relaxed text-slate-600">{useCase.job}</p>
              <p class="mt-3 text-base font-medium leading-relaxed text-brand-800">{useCase.outcome}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.faq.length > 0 && (
    <section class="border-y border-sand-200 bg-sand-50 py-16 sm:py-24">
      <div class="container-wide reveal max-w-3xl">
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.faq.headline}
        </h2>
        <div class="mt-10 divide-y divide-sand-200 border-y border-sand-200">
          {d.faq.map((item) => (
            <div class="py-1">
              <details class="group">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-md py-4 text-left font-display text-lg font-semibold text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500">
                  <h3>{item.q}</h3>
                  <svg class="mt-1.5 shrink-0 text-water-600 transition group-open:rotate-45" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </summary>
                <p class="pb-5 pr-8 text-base leading-relaxed text-slate-600">{item.a}</p>
              </details>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA -->
  <section class="pb-16 sm:pb-24">
    <div class="container-wide">
      <div class="reveal rounded-3xl bg-brand-900 p-10 sm:p-16">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
            {t.cta.headlinePrefix} {d.name}?
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-brand-100">
            {isFree ? t.cta.bodyFree : t.cta.bodyPaid}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            {d.marketplaceUrl && (
              <a href={outbound(d.marketplaceUrl, slug, 'footer-cta')} class="btn-cta" rel="noopener" target="_blank">
                {t.installShort}
              </a>
            )}
            <a href={withLocale(lang, '/contact/')} class="btn-secondary !bg-paper">{t.talkToUs}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  {d.screenshots.length > 0 && (
    <dialog
      id="screenshot-lightbox"
      class="m-auto w-[min(92vw,1400px)] max-w-none rounded-3xl border-0 bg-transparent p-0 backdrop:bg-brand-950/80 backdrop:backdrop-blur-sm"
    >
      <div class="relative">
        <button
          type="button"
          aria-label={t.gallery.close}
          data-lightbox-close
          class="absolute right-3 top-3 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-brand-900/85 text-white transition hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
        <img id="lightbox-image" alt="" class="block max-h-[80vh] w-full rounded-3xl bg-brand-950 object-contain" />
        <p id="lightbox-caption" class="mt-3 px-2 text-center text-sm text-white/90 drop-shadow"></p>
      </div>
    </dialog>

    <script>
      const dialog = document.getElementById('screenshot-lightbox') as HTMLDialogElement | null;
      const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
      const caption = document.getElementById('lightbox-caption');
      const closeBtn = document.querySelector('[data-lightbox-close]') as HTMLButtonElement | null;

      document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!dialog || !image) return;
          image.src = btn.dataset.full ?? '';
          image.alt = btn.dataset.caption ?? '';
          if (caption) caption.textContent = btn.dataset.caption ?? '';
          dialog.showModal();
        });
      });

      closeBtn?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    </script>
  )}
</BaseLayout>
