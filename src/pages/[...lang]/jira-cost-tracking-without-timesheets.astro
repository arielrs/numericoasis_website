---
/**
 * The no-timesheets landing page, in all three locales.
 *
 * One route file per landing page, deliberately, rather than a catch-all
 * `[slug].astro` under `[...lang]`. A catch-all there would also match /about/,
 * /contact/ and /privacy/, and Astro would resolve the collision in an order
 * nobody wants to depend on. The cost is one small file per page; the benefit is
 * that the route list stays readable and nothing can be shadowed by accident.
 *
 * This page exists to receive paid traffic on an ad group about costing Jira
 * work without asking anyone to fill in a timesheet. It is not on /blog/,
 * because it is undated and it is not part of the feed, and it is not in
 * NAV_LINKS, because ads and the OnBudget page are how it is reached.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { localeStaticPaths, useTranslations, withLocale, type Locale } from '../../i18n';
import { ORG_ID, WEBSITE_ID, type JsonLdNode } from '../../lib/schema';
import { outbound } from '../../lib/outbound';

const SLUG = 'jira-cost-tracking-without-timesheets';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const chrome = useTranslations(lang);

// Found by frontmatter rather than by entry id. The glob loader's id format is
// derived from the file path and is not something a route should depend on:
// lang plus translationKey is what the content actually declares.
const entry = (
  await getCollection('landings', ({ data }) => data.lang === lang && !data.draft)
).find((e) => e.data.translationKey === SLUG);
if (!entry) {
  throw new Error(
    `Missing landings/${lang}/${SLUG}. This route is trilingual and the parity ` +
      `gate in scripts/check-content.mjs expects all three.`,
  );
}
const { Content } = await render(entry);

/** The app this page sells, for the install button and the schema link. */
const app = (await getCollection('apps', ({ data }) => data.lang === lang)).find(
  (a) => a.data.translationKey === entry.data.app,
);

const canonical = new URL(withLocale(lang, `/${SLUG}/`), SITE.url).toString();

// Article rather than WebPage: this is a written argument with a subject, and
// the distinction is one answer engines use when deciding what a page is. No
// FAQPage node, because the page is prose rather than question and answer, and
// marking up something as a FAQ that a reader does not experience as one is the
// kind of thing that gets structured data ignored.
const article: JsonLdNode = {
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: entry.data.title,
  description: entry.data.description,
  url: canonical,
  inLanguage: lang,
  isPartOf: { '@id': WEBSITE_ID },
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  publisher: { '@id': ORG_ID },
  author: { '@id': ORG_ID },
  ...(entry.data.updatedDate && {
    dateModified: entry.data.updatedDate.toISOString().slice(0, 10),
  }),
  ...(app && {
    about: { '@id': `${new URL(withLocale(lang, app.data.landingPath ?? `/apps/${entry.data.app}/`), SITE.url)}#software` },
  }),
};

const appHref = app ? withLocale(lang, app.data.landingPath ?? `/apps/${entry.data.app}/`) : undefined;
---

<BaseLayout
  title={entry.data.metaTitle ?? entry.data.title}
  description={entry.data.description}
  metaDescription={entry.data.metaDescription}
  navCta={app?.data.marketplaceUrl
    ? {
        href: outbound(app.data.marketplaceUrl, SLUG, 'nav'),
        label: chrome.apps.viewOnMarketplace,
        external: true,
      }
    : undefined}
  graph={{
    breadcrumbs: [{ name: entry.data.title, path: `/${SLUG}/` }],
    extraNodes: [article],
    primaryEntityId: `${canonical}#article`,
  }}
>
  <section class="border-b border-sand-200 bg-sand-50 py-16 sm:py-20">
    <div class="container-wide max-w-3xl" data-enter>
      {entry.data.eyebrow && <p class="eyebrow">{entry.data.eyebrow}</p>}
      <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight text-brand-900 sm:text-5xl">
        {entry.data.title}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-700">{entry.data.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {app?.data.marketplaceUrl && (
          <a
            href={outbound(app.data.marketplaceUrl, SLUG, 'hero')}
            class="btn-cta"
            rel="noopener"
            target="_blank"
          >{chrome.apps.installOnMarketplace}</a>
        )}
        {appHref && <a href={appHref} class="btn-secondary">{app?.data.name}</a>}
      </div>
      <p class="mt-4 text-sm text-slate-600">{chrome.apps.priceTrial}</p>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="container-wide prose-custom max-w-3xl">
      <Content />
    </div>
  </section>

  <section class="pb-16 sm:pb-24">
    <div class="container-wide max-w-3xl">
      <div class="rounded-3xl bg-brand-900 p-8 sm:p-12">
        <h2 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
          {chrome.landing.ctaHeading}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-brand-100">{chrome.landing.ctaBody}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          {app?.data.marketplaceUrl && (
            <a
              href={outbound(app.data.marketplaceUrl, SLUG, 'footer-cta')}
              class="btn-cta"
              rel="noopener"
              target="_blank"
            >{chrome.apps.installOnMarketplace}</a>
          )}
          <a href={withLocale(lang, '/contact/')} class="btn-secondary !bg-paper">
            {chrome.common.talkToTheTeam}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
