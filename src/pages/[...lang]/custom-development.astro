---
/**
 * Custom Development, the first of the three fronts, for all three locales.
 *
 * There is no client logo wall here on purpose. The work we can show without
 * anybody's permission is our own, and it is public: the Marketplace apps, this
 * site and the game. So the proof section points at those rather than at a
 * description of projects a reader cannot check.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { localeStaticPaths, withLocale, type Locale } from '../../i18n';
import { customDev } from '../../i18n/pages/custom-development';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = customDev[lang];

const posts = (
  await getCollection(
    'blog',
    ({ data }) => data.lang === lang && !data.draft && data.tags.includes('custom-development'),
  )
)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const linkClass =
  'inline-flex items-center gap-1.5 rounded-md text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500';
const arrow = '<path d="M5 12h14M13 5l7 7-7 7" />';
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  metaDescription={t.meta.metaDescription}
  graph={{
    breadcrumbs: [{ name: t.meta.crumb, path: '/custom-development/' }],
    pageType: 'CollectionPage',
  }}
>
  <!-- HERO -->
  <section class="border-b border-sand-200 bg-sand-50 py-16 sm:py-24">
    <div class="container-wide" data-enter>
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="mt-3 max-w-4xl font-display text-4xl font-bold leading-tight tracking-tight text-brand-900 sm:text-5xl md:text-6xl">
        {t.hero.headline}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">{t.hero.lede}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={withLocale(lang, '/contact/')} class="btn-cta">{t.hero.primary}</a>
        <a href="#how" class="btn-secondary">{t.hero.secondary}</a>
      </div>
    </div>
  </section>

  <!-- WHAT WE BUILD: the heading holds the left column while the four kinds of
       work run down the right, so the section reads as one list rather than as
       four cards competing for attention. -->
  <section class="py-16 sm:py-24">
    <div class="container-wide grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">{t.build.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.build.headline}
        </h2>
      </div>
      <dl class="divide-y divide-sand-200 border-y border-sand-200">
        {t.build.items.map((item) => (
          <div class="py-7">
            <dt class="font-display text-xl font-semibold text-brand-900">{item.title}</dt>
            <dd class="mt-2 text-base leading-relaxed text-slate-600">{item.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- HOW WE WORK: a sequence, so it is numbered and laid out in order -->
  <section id="how" class="scroll-mt-24 border-y border-sand-200 bg-sand-50 py-16 sm:py-24">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.how.headline}
        </h2>
      </div>
      <ol class="mt-12 grid gap-10 md:grid-cols-2 xl:grid-cols-4 xl:gap-8">
        {t.how.steps.map((step, i) => (
          <li class="border-t-2 border-brand-900 pt-5">
            <span class="font-display text-sm font-bold text-sun-800 tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 font-display text-lg font-semibold text-brand-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROOF -->
  <section class="py-16 sm:py-24">
    <div class="container-wide">
      <div class="rounded-3xl bg-brand-900 p-8 sm:p-12">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] lg:gap-16">
          <div>
            <p class="text-xs font-semibold tracking-widest text-sun-400 uppercase">{t.proof.eyebrow}</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
              {t.proof.headline}
            </h2>
          </div>
          <div>
            {t.proof.paragraphs.map((p) => (
              <p class="mb-5 text-base leading-relaxed text-brand-100 last:mb-0">{p}</p>
            ))}
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={withLocale(lang, '/apps/')} class="btn-cta">{t.proof.apps}</a>
              <a href={withLocale(lang, '/studio/')} class="btn-secondary !bg-paper">{t.proof.studio}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- POSTS -->
  {posts.length > 0 && (
    <section class="border-t border-sand-200 py-16 sm:py-24">
      <div class="container-wide">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">{t.posts.eyebrow}</p>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
              {t.posts.headline}
            </h2>
          </div>
          <a href={withLocale(lang, '/blog/tag/custom-development/')} class={`${linkClass} text-water-700 hover:text-water-800`}>
            {t.posts.link}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
          </a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {posts.map((post) => <PostCard post={post} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="border-t border-sand-200 bg-sand-50 py-16 sm:py-20">
    <div class="container-wide max-w-3xl">
      <h2 class="font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">{t.cta.heading}</h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">{t.cta.body}</p>
      <div class="mt-8">
        <a href={withLocale(lang, '/contact/')} class="btn-cta">{t.cta.primary}</a>
      </div>
    </div>
  </section>
</BaseLayout>
