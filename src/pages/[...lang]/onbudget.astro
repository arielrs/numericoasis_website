---
/**
 * The OnBudget landing page: /onbudget/, /pt-BR/onbudget/ and /es/onbudget/.
 *
 * This is the only indexable page for OnBudget. /apps/onbudget/ redirects here,
 * and the app is filtered out of the /apps/<slug>/ route, so one product has one
 * URL rather than two competing for the same query.
 *
 * All the copy comes from the app's content entry, which Zod refuses to build
 * unless a flagship carries answerFirst, a problem block, at least three steps
 * and at least eight FAQ entries, in every locale.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { localeStaticPaths, contentSlug, withLocale, type Locale } from '../../i18n';
import { onbudget as copy } from '../../i18n/pages/onbudget';
import { ORG_ID, WEBSITE_ID, type JsonLdNode } from '../../lib/schema';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = copy[lang];

const entries = await getCollection('apps', ({ data }) => data.lang === lang && data.flagship);
const app = entries[0];
if (!app) throw new Error(`No flagship app found for locale "${lang}"`);
const d = app.data;

/** Screenshots are addressed by slot so the layout does not depend on their order. */
const shot = (slot: string) => d.screenshots.find((s) => s.slot === slot);

const canonical = new URL(withLocale(lang, '/onbudget/'), SITE.url).toString();
const appId = `${canonical}#software`;

const softwareNode: JsonLdNode = {
  '@type': 'SoftwareApplication',
  '@id': appId,
  name: d.listingName ?? d.name,
  alternateName: d.name,
  description: d.answerFirst ?? d.description,
  abstract: d.tagline,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'AtlassianMarketplaceApp',
  operatingSystem: 'Atlassian Cloud',
  url: canonical,
  isPartOf: { '@id': WEBSITE_ID },
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  publisher: { '@id': ORG_ID },
  provider: { '@id': ORG_ID },
  ...(d.version && { softwareVersion: d.version }),
  ...(d.dateModified && { dateModified: d.dateModified.toISOString().slice(0, 10) }),
  featureList: [...d.keyFeatures],
  audience: d.audiences.map((a) => ({ '@type': 'Audience', audienceType: a })),
  ...(d.marketplaceUrl && {
    downloadUrl: d.marketplaceUrl,
    installUrl: d.marketplaceUrl,
    sameAs: [d.marketplaceUrl],
  }),
  screenshot: d.screenshots.slice(0, 5).map((s) => ({
    '@type': 'ImageObject',
    url: new URL(s.image.src, SITE.url).toString(),
    width: s.image.width,
    height: s.image.height,
    caption: s.caption,
  })),
  // No offers: we do not publish prices, and an Offer without one is invalid.
  // No aggregateRating: it needs a review count we do not publish, and Google
  // requires the reviews themselves to be rendered on the page.
};

const faqNode: JsonLdNode = {
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: d.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const otherApps = (
  await getCollection('apps', ({ data }) => data.lang === lang && !data.flagship)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={t.meta.title}
  description={d.answerFirst}
  image={shot('hero')?.image}
  graph={{
    breadcrumbs: [{ name: t.meta.crumb, path: '/onbudget/' }],
    extraNodes: [softwareNode, faqNode],
    primaryEntityId: appId,
    pageType: 'ItemPage',
  }}
>
  <!-- 1. HERO -->
  <section class="border-b border-sand-200 bg-sand-50">
    <div class="container-wide grid gap-12 py-16 sm:py-24 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-16">
      <div>
        <div class="flex items-center gap-4">
          {d.icon && (
            <Image src={d.icon} alt="" width={64} class="h-16 w-16 rounded-2xl ring-1 ring-sand-200" priority />
          )}
          <p class="eyebrow">{t.hero.eyebrow}</p>
        </div>
        <h1 class="mt-6 font-display text-4xl font-bold leading-tight tracking-tight text-brand-900 sm:text-5xl">
          {t.hero.headline}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-slate-700">{d.answerFirst}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          {d.marketplaceUrl && (
            <a href={d.marketplaceUrl} class="btn-cta" rel="noopener" target="_blank">
              {t.cta.primary}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M7 7h10v10" /></svg>
            </a>
          )}
          <a href="#how-it-works" class="btn-secondary">{t.hero.ctaSecondary}</a>
        </div>
      </div>

      {shot('hero') && (
        <figure class="lg:-mr-10">
          <Image
            src={shot('hero')!.image}
            alt={shot('hero')!.alt ?? shot('hero')!.caption}
            width={1280}
            sizes="(min-width: 1024px) 640px, 100vw"
            class="w-full rounded-2xl border border-sand-200 bg-paper"
            priority
          />
        </figure>
      )}
    </div>
  </section>

  <!-- 2. TRUST STRIP -->
  {d.trustSignals.length > 0 && (
    <section class="border-b border-sand-200 bg-paper py-6">
      <div class="container-wide">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs font-semibold uppercase tracking-[0.14em] text-brand-700">
          {d.trustSignals.map((signal) => (
            <li class="flex items-center gap-2">
              <svg class="text-water-600" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
              {signal}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 3. THE PROBLEM -->
  {d.problem && (
    <section class="py-16 sm:py-24">
      <div class="container-wide grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] lg:items-center lg:gap-16">
        <div>
          <p class="eyebrow">{t.problem.eyebrow}</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
            {d.problem.heading}
          </h2>
          <p class="mt-5 text-base leading-relaxed text-slate-600">{d.problem.body}</p>
          <ul class="mt-8 space-y-3">
            {d.problem.questions.map((q) => (
              <li class="rounded-xl bg-sand-100 px-4 py-3 text-base font-medium text-brand-900">{q}</li>
            ))}
          </ul>
        </div>
        {shot('report-over-budget') && (
          <figure>
            <Image
              src={shot('report-over-budget')!.image}
              alt={shot('report-over-budget')!.alt ?? shot('report-over-budget')!.caption}
              width={1280}
              sizes="(min-width: 1024px) 640px, 100vw"
              class="w-full rounded-2xl border border-sand-200 bg-paper"
              loading="lazy"
            />
            <figcaption class="mt-3 text-sm leading-relaxed text-slate-600">
              {shot('report-over-budget')!.caption}
            </figcaption>
          </figure>
        )}
      </div>
    </section>
  )}

  <!-- 4. HOW A REPORT GETS BUILT: alternating full-width rows -->
  <section id="how-it-works" class="scroll-mt-24 border-y border-sand-200 bg-sand-50 py-16 sm:py-24">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="eyebrow">{t.steps.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.steps.headline}
        </h2>
      </div>

      <ol class="mt-14 space-y-16">
        {d.steps.map((step, i) => {
          const image = step.shot ? shot(step.shot) : undefined;
          return (
            <li class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-14">
              <div class:list={[i % 2 === 1 && 'lg:order-2']}>
                <p class="font-mono text-sm font-semibold text-water-700">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight text-brand-900">
                  {step.title}
                </h3>
                <p class="mt-4 text-base leading-relaxed text-slate-600">{step.body}</p>
              </div>
              {image && (
                <figure class:list={[i % 2 === 1 && 'lg:order-1']}>
                  <Image
                    src={image.image}
                    alt={image.alt ?? image.caption}
                    width={1280}
                    sizes="(min-width: 1024px) 560px, 100vw"
                    class="w-full rounded-2xl border border-sand-200 bg-paper"
                    loading="lazy"
                  />
                </figure>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- 5. PICK THE SIGNAL: coverage discovery is the differentiator -->
  <section class="py-16 sm:py-24">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">{t.methods.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.methods.headline}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{t.methods.lede}</p>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-14">
        <div class="space-y-8">
          {d.featureGroups.slice(0, 2).map((group) => (
            <div>
              <h3 class="font-display text-xl font-semibold tracking-tight text-brand-900">{group.name}</h3>
              {group.blurb && <p class="mt-2 text-sm leading-relaxed text-slate-600">{group.blurb}</p>}
              <ul class="mt-4 space-y-2">
                {group.items.map((item) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
                    <svg class="mt-1 shrink-0 text-water-600" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {shot('builder-method') && (
          <figure>
            <Image
              src={shot('builder-method')!.image}
              alt={shot('builder-method')!.alt ?? shot('builder-method')!.caption}
              width={1280}
              sizes="(min-width: 1024px) 700px, 100vw"
              class="w-full rounded-2xl border border-sand-200 bg-paper"
              loading="lazy"
            />
            <figcaption class="mt-3 text-sm leading-relaxed text-slate-600">
              {shot('builder-method')!.caption}
            </figcaption>
          </figure>
        )}
      </div>
    </div>
  </section>

  <!-- 6. DASHBOARDS -->
  <section class="border-y border-sand-200 bg-sand-50 py-16 sm:py-24">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">{t.dashboard.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.dashboard.headline}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{t.dashboard.lede}</p>
      </div>

      {d.featureGroups[2] && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {d.featureGroups[2].items.map((item) => (
            <li class="rounded-full border border-sand-200 bg-paper px-3.5 py-1.5 text-sm font-medium text-brand-800">
              {item}
            </li>
          ))}
        </ul>
      )}

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {['report-at-risk', 'edit-layout'].map((slot) =>
          shot(slot) ? (
            <figure>
              <Image
                src={shot(slot)!.image}
                alt={shot(slot)!.alt ?? shot(slot)!.caption}
                width={1280}
                sizes="(min-width: 1024px) 560px, 100vw"
                class="w-full rounded-2xl border border-sand-200 bg-paper"
                loading="lazy"
              />
              <figcaption class="mt-3 text-sm leading-relaxed text-slate-600">{shot(slot)!.caption}</figcaption>
            </figure>
          ) : null,
        )}
      </div>
    </div>
  </section>

  <!-- 7. SHARING -->
  <section class="py-16 sm:py-24">
    <div class="container-wide grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-16">
      <div>
        <p class="eyebrow">{t.sharing.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.sharing.headline}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-slate-600">{t.sharing.body}</p>
      </div>
      {shot('table-shared') && (
        <figure>
          <Image
            src={shot('table-shared')!.image}
            alt={shot('table-shared')!.alt ?? shot('table-shared')!.caption}
            width={1280}
            sizes="(min-width: 1024px) 640px, 100vw"
            class="w-full rounded-2xl border border-sand-200 bg-paper"
            loading="lazy"
          />
        </figure>
      )}
    </div>
  </section>

  <!-- 8. AT SCALE -->
  <section class="border-y border-sand-200 bg-sand-50 py-16 sm:py-24">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">{t.scale.eyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
          {t.scale.headline}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{t.scale.lede}</p>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] lg:items-start lg:gap-14">
        {d.featureGroups[3] && (
          <ul class="space-y-2">
            {d.featureGroups[3].items.map((item) => (
              <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
                <svg class="mt-1 shrink-0 text-water-600" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="grid gap-6 sm:grid-cols-2">
          {['bulk', 'search'].map((slot) =>
            shot(slot) ? (
              <figure>
                <Image
                  src={shot(slot)!.image}
                  alt={shot(slot)!.alt ?? shot(slot)!.caption}
                  width={960}
                  sizes="(min-width: 1024px) 340px, (min-width: 640px) 45vw, 100vw"
                  class="w-full rounded-2xl border border-sand-200 bg-paper"
                  loading="lazy"
                />
              </figure>
            ) : null,
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 9. SECURITY AND DATA -->
  <section class="py-16 sm:py-24">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">{t.security.eyebrow}</p>
      <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">
        {t.security.headline}
      </h2>
      {d.dataStatement && (
        <p class="mt-5 text-base leading-relaxed text-slate-600">{d.dataStatement}</p>
      )}
      {d.scopeSummary.length > 0 && (
        <>
          <p class="mt-7 text-xs font-semibold uppercase tracking-[0.14em] text-brand-700">
            {t.security.scopes}
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {d.scopeSummary.map((scope) => (
              <li class="rounded-md bg-sand-100 px-2.5 py-1 font-mono text-xs text-brand-800">{scope}</li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>

  <!-- 10. LANGUAGES -->
  <section class="border-t border-sand-200 py-16 sm:py-24">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">{t.languages.eyebrow}</p>
      <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">
        {t.languages.headline}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-slate-600">{t.languages.body}</p>
    </div>
  </section>

  <!-- 11. FAQ -->
  <section class="border-y border-sand-200 bg-sand-50 py-16 sm:py-24">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">
        {t.faq.headline}
      </h2>
      <dl class="mt-10 divide-y divide-sand-200 border-y border-sand-200">
        {d.faq.map((item) => (
          <div class="py-1">
            <details class="group">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-md py-4 text-left font-display text-lg font-semibold text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500">
                <dt>{item.q}</dt>
                <svg class="mt-1.5 shrink-0 text-water-600 transition group-open:rotate-45" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              </summary>
              <dd class="pb-5 pr-8 text-base leading-relaxed text-slate-600">{item.a}</dd>
            </details>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 12. CTA + the rest of the portfolio -->
  <section class="py-16 sm:py-24">
    <div class="container-wide">
      <div class="rounded-3xl bg-brand-900 p-10 sm:p-16">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
            {t.cta.headline}
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-brand-100">{t.cta.body}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            {d.marketplaceUrl && (
              <a href={d.marketplaceUrl} class="btn-cta" rel="noopener" target="_blank">{t.cta.primary}</a>
            )}
            <a href={withLocale(lang, '/contact/')} class="btn-secondary !bg-paper">{t.cta.secondary}</a>
          </div>
        </div>
      </div>

      <div class="mt-16">
        <p class="eyebrow">{t.alsoSee.eyebrow}</p>
        <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-brand-900">
          {t.alsoSee.headline}
        </h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {otherApps.map((other) => (
            <li>
              <a
                href={withLocale(lang, `/apps/${contentSlug(other.id)}/`)}
                class="inline-block rounded-full border border-sand-200 bg-paper px-4 py-2 text-sm font-medium text-brand-800 transition hover:border-water-400 hover:text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
              >
                {other.data.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-6">
          <a
            href={withLocale(lang, '/apps/')}
            class="inline-flex items-center gap-1.5 rounded-md text-sm font-semibold text-water-700 transition hover:text-water-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
          >
            {t.alsoSee.link}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
