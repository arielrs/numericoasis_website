---
/**
 * One game's guide index, e.g. /studio/wiki/kindelve/.
 *
 * The studio twin of /documentation/<app>/: the URL a reader hand-truncates
 * for the rest of a game's guide, and the middle crumb of every leaf.
 */
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import { SITE } from '../../../../consts';
import { docGroups, docHref, groupHref } from '../../../../lib/docs';
import { WEBSITE_ID, type JsonLdNode } from '../../../../lib/schema';
import { outbound } from '../../../../lib/outbound';

export async function getStaticPaths() {
  const groups = await docGroups('studio');
  return groups.map((group) => ({ params: { game: group.app }, props: { group, groups } }));
}

const { group, groups } = Astro.props as {
  group: Awaited<ReturnType<typeof docGroups>>[number];
  groups: Awaited<ReturnType<typeof docGroups>>;
};

const canonical = new URL(groupHref(group.app), SITE.url).toString();

const itemList: JsonLdNode = {
  '@type': 'ItemList',
  '@id': `${canonical}#pages`,
  name: `${group.label} player guide`,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: group.pages.length,
  isPartOf: { '@id': WEBSITE_ID },
  itemListElement: group.pages.map((page, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: page.data.title,
    url: new URL(docHref(page), SITE.url).toString(),
  })),
};
---

<DocsLayout
  title={`${group.label} player guide`}
  description={group.indexDescription ?? `How ${group.label} works, in full. ${group.blurb}`}
  groups={groups}
  section="studio"
  currentApp={group.app}
  graph={{
    breadcrumbs: [
      { name: 'Game Studio', path: '/studio/' },
      { name: 'Wiki', path: '/studio/wiki/' },
      { name: group.label, path: groupHref(group.app) },
    ],
    extraNodes: [itemList],
    primaryEntityId: `${canonical}#pages`,
    pageType: 'CollectionPage',
  }}
>
  <header class="max-w-3xl">
    <p class="eyebrow">Player guide</p>
    <h1 class="mt-1 font-display text-3xl font-bold leading-tight tracking-tight text-brand-900 sm:text-4xl">
      {group.label}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-slate-700">{group.indexDescription ?? group.blurb}</p>
  </header>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    {group.pages.map((page) => (
      <li>
        <a
          href={docHref(page)}
          class="group flex h-full flex-col rounded-2xl border border-sand-200 bg-paper p-5 transition duration-200 ease-out-soft hover:-translate-y-1 hover:border-water-400 hover:shadow-[var(--shadow-soft)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
        >
          <span class="font-display text-base font-semibold text-brand-900 transition group-hover:text-brand-700">
            {page.data.title}
          </span>
          <span class="mt-1.5 text-sm leading-relaxed text-slate-600">{page.data.description}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="mt-10 flex flex-wrap gap-3">
    {group.playUrl && (
      <a href={outbound(group.playUrl, `wiki-${group.app}`, 'doc-index')} class="btn-cta" rel="noopener" target="_blank">
        Play {group.label}
      </a>
    )}
    <a href="/studio/" class="btn-secondary">About the Game Studio</a>
  </div>
</DocsLayout>
