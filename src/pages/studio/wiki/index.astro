---
/**
 * The Game Studio wiki: player guides, one group per game.
 *
 * Split out of the apps wiki on 2026-11-23, so a player never lands in a
 * sidebar of Jira apps and an administrator never finds a game in theirs. It
 * reuses the docs layout and the docs collection; only the section differs.
 *
 * English only, like /documentation/, and for the same reason: outside the
 * [...lang] tree, exempt from route parity in check-dist.mjs.
 */
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { SITE } from '../../../consts';
import { docGroups, docHref, groupHref } from '../../../lib/docs';
import { WEBSITE_ID, type JsonLdNode } from '../../../lib/schema';
import { outbound } from '../../../lib/outbound';

const groups = await docGroups('studio');

const canonical = new URL('/studio/wiki/', SITE.url).toString();

const itemList: JsonLdNode = {
  '@type': 'ItemList',
  '@id': `${canonical}#guidelist`,
  name: 'Numeric Oasis Game Studio wiki',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: groups.reduce((n, g) => n + g.pages.length, 0),
  isPartOf: { '@id': WEBSITE_ID },
  itemListElement: groups.flatMap((group, gi) =>
    group.pages.map((page, pi) => ({
      '@type': 'ListItem',
      position: gi * 100 + pi + 1,
      name: `${group.label}: ${page.data.title}`,
      url: new URL(docHref(page), SITE.url).toString(),
    })),
  ),
};

const linkClass =
  'group/link inline-flex items-center gap-1.5 rounded-sm text-sm text-water-700 transition duration-200 ease-out-soft hover:text-water-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500';
---

<DocsLayout
  title="Game Studio wiki: player guides for our games"
  description="How our games work, in full. Kindelve's player guide: the descent, the Kin you send into it, builds, the Warden, the daily Trial, saves, and what the game stores."
  groups={groups}
  section="studio"
  graph={{
    breadcrumbs: [
      { name: 'Game Studio', path: '/studio/' },
      { name: 'Wiki', path: '/studio/wiki/' },
    ],
    extraNodes: [itemList],
    primaryEntityId: `${canonical}#guidelist`,
    pageType: 'CollectionPage',
  }}
>
  <header class="max-w-3xl">
    <p class="eyebrow">Game Studio wiki</p>
    <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-brand-900 sm:text-4xl">
      Player guides for our games.
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-slate-700">
      How each game works, in full: what you do, the systems underneath, and
      what the game keeps about you. Written for players, and kept current with
      every update.
    </p>
  </header>

  {groups.map((group) => (
    <section class="mt-12 grid gap-8 rounded-2xl border border-sand-200 bg-paper p-7 sm:p-9 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-12">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-brand-900">
          <a
            href={groupHref(group.app)}
            class="rounded-sm transition duration-200 ease-out-soft hover:text-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
          >{group.label}</a>
        </h2>
        <p class="mt-3 text-base leading-relaxed text-slate-600">{group.blurb}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          {group.playUrl && (
            <a href={outbound(group.playUrl, 'studio-wiki', 'doc-index')} class="btn-cta" rel="noopener" target="_blank">
              Play {group.label}
            </a>
          )}
          <a href={groupHref(group.app)} class="btn-secondary !bg-paper">Open the guide</a>
        </div>
      </div>
      <ul class="grid gap-x-8 gap-y-1.5 self-center sm:grid-cols-2">
        {group.pages.map((page) => (
          <li>
            <a href={docHref(page)} class={linkClass}>
              {page.data.title}
              <svg
                class="transition duration-200 ease-out-soft group-hover/link:translate-x-0.5"
                width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              ><path d="M5 12h14M13 5l7 7-7 7" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="mt-8 rounded-3xl bg-brand-900 p-8 sm:p-12">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
        Not answered here?
      </h2>
      <p class="mt-3 text-base leading-relaxed text-brand-100">
        Bugs, purchases and lost progress go to the players' help desk, where a
        person reads every request. It asks which game the request is about, so
        it reaches the right people the first time.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={outbound(SITE.gameSupportUrl, 'studio-wiki', 'support')} class="btn-cta" rel="noopener" target="_blank">Get help with a game</a>
        <a href="/studio/" class="btn-secondary !bg-paper">About the Game Studio</a>
      </div>
    </div>
  </section>
</DocsLayout>
