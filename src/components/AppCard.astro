---
/**
 * One app, as a card.
 *
 * The card used to be a single wrapping <a>, which meant it could hold exactly
 * one link, and neither the home page nor /apps/ linked to a single Marketplace
 * listing as a result. Three of the four prominent calls to action on the site
 * point at pages made of these cards, so that was the conversion path ending in
 * a dead end.
 *
 * It is now an <article> with two real links and a stretched overlay: the
 * "Read more" anchor carries `after:absolute after:inset-0`, so the whole card
 * stays clickable, and the Marketplace anchor sits above it on `relative z-10`.
 * Nesting one <a> inside another would have been invalid markup and a
 * nested-interactive violation, which is why the wrapper had to go.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { PRODUCT_LABELS } from '../consts';
import { contentSlug, withLocale, useTranslations, type Locale } from '../i18n';

interface Props {
  app: CollectionEntry<'apps'>;
  lang: Locale;
  labels: {
    builtFor: string;
    readMore: string;
  };
  /** The app we are currently pushing spans its row. No label, just more room. */
  wide?: boolean;
  /** Opt in to the scroll reveal. Off by default so a card can render statically. */
  reveal?: boolean;
}

const { app, lang, labels, wide = false, reveal = false } = Astro.props;
const t = useTranslations(lang);

// An app with its own landing page links there, not to /apps/<slug>/.
const href = withLocale(lang, app.data.landingPath ?? `/apps/${contentSlug(app.id)}/`);

const focusRing =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500';
---

<article
  class:list={[
    'group relative flex flex-col justify-between rounded-2xl border border-sand-200 bg-paper p-8',
    'transition duration-200 ease-out-soft hover:-translate-y-1 hover:border-water-400 hover:shadow-[var(--shadow-soft)]',
    reveal && 'reveal',
    wide && 'md:col-span-2',
  ]}
>
  <div>
    <div class="flex items-center gap-4">
      {app.data.icon ? (
        <Image
          src={app.data.icon}
          alt=""
          width={wide ? 80 : 64}
          class:list={[
            'shrink-0 rounded-2xl object-cover ring-1 ring-sand-200',
            wide ? 'h-20 w-20' : 'h-16 w-16',
          ]}
        />
      ) : (
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-brand-900 font-display text-lg font-bold text-white">
          {app.data.name.charAt(0)}
        </div>
      )}
      <div>
        <h3
          class:list={[
            'font-display font-semibold text-brand-900 transition group-hover:text-brand-700',
            wide ? 'text-2xl' : 'text-xl',
          ]}
        >
          {app.data.name}
        </h3>
        <p class="mt-1 text-sm font-medium text-slate-700">{app.data.tagline}</p>
      </div>
    </div>

    <p class:list={['mt-5 text-base leading-relaxed text-slate-600', wide && 'max-w-3xl']}>
      {app.data.description}
    </p>

    {app.data.audiences.length > 0 && (
      <p class:list={['mt-4 text-xs leading-relaxed text-slate-600', wide && 'max-w-3xl']}>
        <span class="font-semibold text-brand-800">{labels.builtFor}:</span>{' '}
        {app.data.audiences.join(' · ')}
      </p>
    )}
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold">
    {app.data.products.map((p) => (
      <span class="rounded-full bg-water-50 px-2.5 py-1 text-water-700">{PRODUCT_LABELS[p] ?? p}</span>
    ))}
    {app.data.priceModel === 'free' && (
      <span class="rounded-full bg-sun-50 px-2.5 py-1 text-sun-700">{t.apps.priceFree}</span>
    )}
    <a
      href={href}
      class:list={['ml-auto rounded-sm text-slate-500 transition duration-200 ease-out-soft after:absolute after:inset-0 group-hover:text-water-700', focusRing]}
      aria-label={`${labels.readMore}: ${app.data.name}`}
    >
      {labels.readMore}
      <svg
        class="ml-1 inline-block align-[-0.1em] transition group-hover:translate-x-0.5"
        width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><path d="M5 12h14M13 5l7 7-7 7" /></svg>
    </a>
  </div>

  {app.data.marketplaceUrl && (
    <a
      href={app.data.marketplaceUrl}
      class:list={[
        'relative z-10 mt-5 inline-flex items-center gap-1.5 self-start rounded-md border border-sand-200 px-3 py-1.5',
        'text-xs font-semibold text-brand-800 transition hover:border-water-400 hover:text-water-700',
        focusRing,
      ]}
      rel="noopener"
      target="_blank"
      aria-label={`${t.apps.viewOnMarketplace}: ${app.data.name}`}
    >
      {t.apps.viewOnMarketplace}
      <svg
        width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><path d="M7 17L17 7M7 7h10v10" /></svg>
    </a>
  )}
</article>
