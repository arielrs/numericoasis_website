---
import { Image } from 'astro:assets';
import { SITE, NAV_LINKS, NAV_CTA } from '../consts';
import logoRound from '../assets/logos/company-round.jpg';
import LangSwitcher from './LangSwitcher.astro';
import { useTranslations, withLocale, type Locale, type LocaleAlternates } from '../i18n';

interface Props {
  lang: Locale;
  /** Overrides for pages whose per-locale URLs are not simple mirrors. */
  alternates?: LocaleAlternates;
  /**
   * Where the header call to action goes on this page.
   *
   * The default, "Browse the apps", points at the portfolio, which is right on
   * a page that is not selling one thing. It is wrong in two places. On /apps/
   * it would be a self link, the only button-styled control in the header
   * pointing at the page it is already on. And on an app landing page it pulls
   * the visitor off the product they arrived for and into a list, which on a
   * page paid traffic lands on is a leak rather than navigation.
   */
  cta?: { href: string; label: string; external?: boolean };
}
const { lang, alternates, cta } = Astro.props;
const t = useTranslations(lang);

const ctaHref = cta ? cta.href : withLocale(lang, NAV_CTA.href);
const ctaLabel = cta ? cta.label : t.nav[NAV_CTA.labelKey];
const ctaRel = cta?.external ? 'noopener' : undefined;
const ctaTarget = cta?.external ? '_blank' : undefined;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === withLocale(lang, '/') : path.startsWith(withLocale(lang, href));

const linkLabel = (key: (typeof NAV_LINKS)[number]['labelKey']) => t.nav[key];

// The documentation is published in English only, at one URL. Passing it
// through withLocale would produce /pt-BR/documentation/, which does not exist.
const navHref = (link: (typeof NAV_LINKS)[number]) =>
  'absolute' in link && link.absolute ? link.href : withLocale(lang, link.href);
---

<header class="sticky top-0 z-50 border-b border-sand-200/60 bg-paper/85 backdrop-blur-lg">
  <nav aria-label={t.nav.mainNavLabel}>
    <div class="container-wide flex h-16 items-center justify-between">
    <a href={withLocale(lang, '/')} class="group flex shrink-0 items-center gap-2.5" aria-label={t.nav.homeAriaLabel(SITE.name)}>
      <Image
        src={logoRound}
        alt=""
        width={36}
        height={36}
        class="h-9 w-9 rounded-xl ring-1 ring-sand-200/60"
        loading="eager"
      />
      <span class="font-display text-base font-semibold tracking-tight text-brand-900">
        Numeric<span class="text-sun-500">·</span>Oasis
      </span>
    </a>

    <!-- Inline from xl only. Seven top-level items, the language switcher and
         the call to action measured 1073px in English, 1103px in Portuguese and
         1089px in Spanish, against 1168px of container at 1280 and 944px at
         1024, so below 1280 the menu button takes over. The logo and the right
         group do not shrink, so a longer label shows up as overflow in review
         rather than as a squashed wordmark. -->
    <div class="hidden items-center xl:flex">
      {NAV_LINKS.map((link) => (
        <a
          href={navHref(link)}
          class:list={[
            'whitespace-nowrap rounded-full px-2.5 py-2 text-sm font-medium transition',
            isActive(link.href)
              ? 'bg-sand-100 text-brand-900'
              : 'text-brand-700 hover:bg-sand-50 hover:text-brand-900',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {linkLabel(link.labelKey)}
        </a>
      ))}
    </div>

    <div class="hidden shrink-0 items-center gap-3 xl:flex">
      <LangSwitcher currentLang={lang} variant="desktop" alternates={alternates} />
      <a href={ctaHref} class="inline-flex whitespace-nowrap btn-cta !py-2 !px-4" rel={ctaRel} target={ctaTarget}>
        {ctaLabel}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>

    <button
      type="button"
      id="nav-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-brand-700 transition duration-200 ease-out-soft hover:bg-sand-100 xl:hidden"
      aria-label={t.nav.toggleMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    </div>

    <div id="mobile-menu" class="hidden border-t border-sand-200 bg-paper xl:hidden">
    <div class="container-wide flex flex-col py-3">
      {NAV_LINKS.map((link) => (
        <a
          href={navHref(link)}
          class:list={[
            'rounded-lg px-3 py-2.5 text-sm font-medium transition',
            isActive(link.href)
              ? 'bg-sand-100 text-brand-900'
              : 'text-brand-700 hover:bg-sand-50',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {linkLabel(link.labelKey)}
        </a>
      ))}
      <div class="mt-2 border-t border-sand-200 pt-2">
        <LangSwitcher currentLang={lang} variant="mobile" alternates={alternates} />
      </div>
      <a href={ctaHref} class="mt-2 btn-cta justify-center" rel={ctaRel} target={ctaTarget}>
        {ctaLabel}
      </a>
    </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
