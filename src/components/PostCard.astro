---
/**
 * One shape for every post card.
 *
 * An earlier version gave the newest post a wide, side-by-side treatment. In a
 * grid row its image stretched to whatever height the tallest neighbouring card
 * happened to be, so a featured image could land at 480px next to two at 209px.
 * Uniform cards remove that mismatch by construction rather than tuning one
 * case, and a fixed aspect ratio keeps every image the same shape whatever the
 * source image happens to be.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { contentSlug, withLocale, type Locale } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Locale;
}

const { post, lang } = Astro.props;

// Frontmatter dates are date-only, so they parse as UTC midnight. Formatting
// them in the build machine's zone shifts anything west of Greenwich back a day,
// which would also disagree with the <time datetime> attribute and the
// datePublished in the structured data. Pin the zone.
const dateFmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : lang, {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={withLocale(lang, `/blog/${contentSlug(post.id)}/`)}
  class="group flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-paper transition duration-150 hover:-translate-y-0.5 hover:border-water-400 hover:shadow-[var(--shadow-soft)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500"
>
  {post.data.heroImage && (
    <Image
      src={post.data.heroImage}
      alt=""
      width={640}
      sizes="(min-width: 1024px) 400px, (min-width: 768px) 45vw, 100vw"
      class="aspect-video w-full object-cover"
      loading="lazy"
    />
  )}
  <div class="flex flex-1 flex-col p-6">
    <time
      class="text-xs font-medium uppercase tracking-[0.12em] text-slate-500"
      datetime={post.data.pubDate.toISOString()}
    >
      {dateFmt.format(post.data.pubDate)}
    </time>
    <h3 class="mt-2 font-display text-lg font-semibold leading-snug text-brand-900 transition group-hover:text-brand-700">
      {post.data.title}
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-slate-600">{post.data.description}</p>
  </div>
</a>
