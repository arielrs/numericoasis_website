---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { contentSlug, withLocale, type Locale } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Locale;
  /** Wide cards break the grid so a list is not a row of identical tiles. */
  wide?: boolean;
}

const { post, lang, wide = false } = Astro.props;

const dateFmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : lang, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={withLocale(lang, `/blog/${contentSlug(post.id)}/`)}
  class:list={[
    'group flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-paper transition duration-150',
    'hover:-translate-y-0.5 hover:border-water-400 hover:shadow-[var(--shadow-soft)]',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sun-500',
    wide && 'md:col-span-2 md:flex-row',
  ]}
>
  {post.data.heroImage && (
    <Image
      src={post.data.heroImage}
      alt=""
      width={wide ? 800 : 560}
      sizes={wide ? '(min-width: 768px) 400px, 100vw' : '(min-width: 768px) 320px, 100vw'}
      class:list={['object-cover', wide ? 'md:w-1/2' : 'aspect-video w-full']}
      loading="lazy"
    />
  )}
  <div class="flex flex-1 flex-col p-6">
    <time
      class="text-xs font-medium uppercase tracking-[0.12em] text-slate-500"
      datetime={post.data.pubDate.toISOString()}
    >
      {dateFmt.format(post.data.pubDate)}
    </time>
    <h3
      class:list={[
        'mt-2 font-display font-semibold leading-snug text-brand-900 transition group-hover:text-brand-700',
        wide ? 'text-xl' : 'text-lg',
      ]}
    >
      {post.data.title}
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-slate-600">{post.data.description}</p>
  </div>
</a>
