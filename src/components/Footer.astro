---
import { Image } from 'astro:assets';
import { SITE } from '../consts';
import logoRound from '../assets/logos/company-round.jpg';
import { useTranslations, withLocale, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="border-t border-sand-200 bg-sand-50">
  <div class="container-wide py-14">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <Image
            src={logoRound}
            alt=""
            width={36}
            height={36}
            class="h-9 w-9 rounded-xl ring-1 ring-sand-200/80"
            loading="lazy"
          />
          <span class="font-display text-base font-semibold tracking-tight text-brand-900">
            Numeric<span class="text-sun-500">·</span>Oasis
          </span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-600">
          {SITE.description}
        </p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold text-brand-900">{t.footer.headings.company}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a class="text-slate-600 hover:text-brand-900" href={withLocale(lang, '/about/')}>{t.footer.links.about}</a></li>
          <li><a class="text-slate-600 hover:text-brand-900" href={withLocale(lang, '/services/')}>{t.footer.links.services}</a></li>
          <li><a class="text-slate-600 hover:text-brand-900" href={withLocale(lang, '/apps/')}>{t.footer.links.apps}</a></li>
          <li><a class="text-slate-600 hover:text-brand-900" href={withLocale(lang, '/blog/')}>{t.footer.links.blog}</a></li>
          <li><a class="text-slate-600 hover:text-brand-900" href={withLocale(lang, '/contact/')}>{t.footer.links.contact}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold text-brand-900">{t.footer.headings.connect}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a class="text-slate-600 hover:text-brand-900" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li>
            <a class="text-slate-600 hover:text-brand-900" href={SITE.marketplaceUrl} rel="noopener" target="_blank">{t.footer.links.marketplace}</a>
          </li>
          {SITE.linkedin && (
            <li>
              <a class="text-slate-600 hover:text-brand-900" href={SITE.linkedin} rel="noopener" target="_blank">{t.footer.links.linkedin}</a>
            </li>
          )}
          <li>
            <a class="text-slate-600 hover:text-brand-900" href="/rss.xml">{t.footer.links.rss}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-sand-200 pt-6 text-xs text-slate-500 md:flex-row md:items-center">
      <p>{t.footer.copyright(year, SITE.name, SITE.location)}</p>
      <p class="font-mono">
        {t.footer.builtWith}
      </p>
    </div>
  </div>
</footer>
